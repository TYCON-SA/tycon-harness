{
  "__doc": "Con qué corren la revisión del plan y la del código (workflow-lite.js). La organización elige la lista en team-repos.json → review_runner.order (de fábrica claude); si uno falla o llega a su tope, el agente se relanza con el siguiente. Cada corredor dice cómo se lanza, dónde deja la respuesta, de qué proveedor salen sus modelos, cómo se reconoce su tope y si corre confinado: en el modo código sólo corre uno confinado. Guía: guides/revisiones-automaticas.md.",
  "name": "review-runner",
  "label": "Revisores automáticos",
  "kind": "reviewRunner",
  "hooks": [],
  "dispatch": [],
  "settings": [],
  "runners": {
    "claude": {
      "label": "Claude",
      "bin": "claude",
      "args": ["-p", "--output-format", "json", "--no-session-persistence", "--strict-mcp-config"],
      "model_flag": "--model",
      "schema_flag": "--json-schema",
      "schema_inline": true,
      "prompt": "stdin",
      "answer": "stdout-json",
      "answer_field": "structured_output",
      "text_field": "result",
      "error_field": "is_error",
      "usage_field": "usage",
      "models": "anthropic",
      "settings_flag": "--settings",
      "settings": { "disableAllHooks": true, "sandbox": { "enabled": true, "autoAllowBashIfSandboxed": true } },
      "tools_flag": "--allowedTools",
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "confined": true
    },
    "codex": {
      "label": "Codex",
      "bin": "codex",
      "args": ["exec", "--sandbox", "workspace-write", "--skip-git-repo-check"],
      "model_flag": "-m",
      "output_flag": "-o",
      "schema_flag": "--output-schema",
      "prompt": "arg",
      "answer": "file",
      "models": "openai",
      "confined": true
    },
    "cursor": {
      "label": "Cursor",
      "bin": "cursor-agent",
      "args": ["-p", "--output-format", "json", "--trust", "--sandbox", "enabled"],
      "model_flag": "--model",
      "cwd_flag": "--workspace",
      "prompt": "arg",
      "answer": "stdout-json",
      "text_field": "result",
      "error_field": "is_error",
      "models": "none",
      "confined": true
    },
    "claude-ollama": {
      "label": "Claude con Ollama",
      "bin": "claude",
      "args": ["-p", "--output-format", "json", "--no-session-persistence", "--strict-mcp-config"],
      "model_flag": "--model",
      "schema_flag": "--json-schema",
      "schema_inline": true,
      "prompt": "stdin",
      "answer": "stdout-json",
      "answer_field": "structured_output",
      "text_field": "result",
      "error_field": "is_error",
      "usage_field": "usage",
      "models": "ollama",
      "env": { "ANTHROPIC_BASE_URL": "http://localhost:11434", "ANTHROPIC_AUTH_TOKEN": "ollama", "ANTHROPIC_API_KEY": "" },
      "settings_flag": "--settings",
      "settings": { "disableAllHooks": true, "sandbox": { "enabled": true, "autoAllowBashIfSandboxed": true } },
      "tools_flag": "--allowedTools",
      "tools": ["Read", "Grep", "Glob", "Bash", "Write", "Edit"],
      "confined": true
    },
    "custom": {
      "label": "Revisor propio",
      "from_profile": "review_runner.custom_command",
      "prompt": "env",
      "answer": "file-env",
      "models": "none",
      "confined": false
    }
  }
}
