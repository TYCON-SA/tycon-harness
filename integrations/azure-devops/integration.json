{
  "__doc": "El conector de Azure DevOps de la capa de plataforma (scripts/lib/platform/platform.js). Usa el az de la máquina (TYCON_ADO_CMD) y su organización (ado.org en config.json); el PAT de lectura del repo del equipo sigue siendo azure.token. Las operaciones que todavía no declara contestan no_soportado. Guía: guides/integrations/platform-connectors.md.",
  "name": "azure-devops",
  "label": "Azure DevOps",
  "kind": "platform",
  "connector": "scripts/connector.js",
  "operations": ["work-item.create", "work-item.update", "work-item.close", "work-item.find", "work-item.read", "deployments.read", "change-request.open", "change-request.list", "change-request.read", "ci.read", "queue.read"],
  "capabilities": { "completedHours": "field", "estimate": "field","workItemType": "native", "autoComplete": "native" },
