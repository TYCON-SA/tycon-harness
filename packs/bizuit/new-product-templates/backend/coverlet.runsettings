<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!--
            Se excluye SOLO el DevHost: es el arnés de desarrollo local, no viaja en el paquete.

            🔴 A propósito NO se heredó la exclusión de repositorios que tiene otro producto
            (`**/Features/**/*Repository.cs`). Esa exclusión es una decisión de ESE producto, con
            su motivo: allá la lógica testeable vive en los *Service.cs y los repositorios están
            cubiertos por pruebas de integración aparte. {{PRODUCT}} todavía no tiene ni una cosa ni la
            otra, así que empezar con la exclusión puesta sería bajar la vara antes de escribir
            la primera prueba. Si algún día hace falta, se agrega con su motivo escrito acá.
          -->
          <Exclude>[DevHost]*</Exclude>
          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
