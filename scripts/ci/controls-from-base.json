    { "name": "workflow-shape", "script": "scripts/ci/check-public-workflow.js", "rules": [] },
    { "name": "base-controls", "script": "scripts/ci/run-base-controls.sh", "rules": [{ "path": ".test-gate.yaml", "optional": true, "sign_on_change": true }] }
