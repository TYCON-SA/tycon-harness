# La capa de la copia: sobre una de las imágenes de requisitos, el repo que se va a instalar y
# lo que la prueba corre adentro. La arma `clean-machine.test.sh` con su contexto (`copy/` y `lab/`); `BASE` es la imagen
# del núcleo o la del paquete.
#
# La copia va en una CAPA con su dueño, nunca montada: en Linux un montaje del anfitrión llega con otro dueño, git se
# niega a clonar de ahí («dubious ownership») y la prueba daría verde sólo en la Mac. De paso, el listado privado de
# reemplazos no puede entrar: no está en el contexto.
ARG BASE
FROM ${BASE}
COPY --chown=node:node copy /srv/tycon-harness
COPY lab /opt/lab
