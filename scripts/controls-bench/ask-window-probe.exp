#!/bin/sh
# ask-window-probe.exp — mide en una sesión de verdad que la ventana de permiso aparece aunque la sesión corra en modo
# bypass, que «Sí» corre el comando y que «No» no lo corre.
#
# Abre `claude` dos veces con un freno de juguete que pide «ask» para un comando marcado: la primera contesta «Sí» y
# espera el archivo que crea el comando; la segunda contesta «No» y comprueba que no se creó. Gasta dos turnos de la
# cuenta que esté iniciada: se corre a mano, con una persona delante, no en la CI.
#
# Uso: sh scripts/controls-bench/ask-window-probe.exp     (o expect, si ya está en el camino)
# Sale 0 si midió y la ventana se portó bien, 1 si midió y no, 3 si no pudo medir («NO MEDIDO»: sin expect, sin claude,
# o la sesión no mostró lo que se esperaba a tiempo). Nunca da verde sin haber visto la ventana.
#
# Las dos líneas que siguen las corre sh; para expect son un comentario que sigue en la línea de abajo. \
command -v expect >/dev/null 2>&1 || { echo "NO MEDIDO: no hay expect en el camino"; exit 3; }
# \
exec expect "$0" "$@"

# lo que `claude` escribe pasa a la terminal de quien corre la sonda, y la sesión se corta antes de que apague el
# seguimiento del mouse: al salir, por donde sea, se apaga (los modos del mouse y el pegado entre corchetes) y vuelve el cursor
exit -onexit { puts -nonewline stdout "\033\[?1000l\033\[?1002l\033\[?1003l\033\[?1006l\033\[?1015l\033\[?2004l\033\[?25h"; flush stdout }
# cortada con una señal (la persona la interrumpe, o la terminal se cierra), sale por el mismo camino
trap { exit [expr {128 + [trap -number]}] } {SIGINT SIGTERM SIGHUP SIGQUIT}

proc no_medido {motivo} { puts "\nNO MEDIDO: $motivo"; exit 3 }
proc rojo {motivo} { puts "\nROJO: $motivo"; exit 1 }

if {[auto_execok claude] eq ""} { no_medido "no hay claude en el camino" }

set dir [exec mktemp -d -t ask-window-probe]
set marca "ask-window-probe-$::env(USER)-[pid]"
set freno [file join $dir freno.sh]
set f [open $freno w]
puts $f "#!/bin/sh"
puts $f "# freno de juguete: pide la ventana para el comando marcado y deja pasar el resto"
puts $f "if grep -q '$marca'; then"
puts $f {  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"sonda de la ventana de permiso"}}'}
puts $f "fi"
puts $f "exit 0"
close $f
set ajustes [file join $dir settings.json]
set f [open $ajustes w]
puts $f "{\"hooks\":{\"PreToolUse\":\[{\"matcher\":\"Bash\",\"hooks\":\[{\"type\":\"command\",\"command\":\"/bin/sh $freno\"}\]}\]}}"
close $f

# Una sesión: pide el comando, espera la ventana y la contesta. `respuesta` es lo que se teclea en la ventana.
# entre palabras, la pantalla puede traer espacios o saltos del cursor (`ESC[17G`) en lugar de espacios
set S {(?:\s|\x1b\[[0-9;]*[A-Za-z])+}

# la pantalla termina de dibujar el menú antes de leer teclas: sin la pausa, la flecha se pierde y queda «No»
# dentro de un proc, `send` sin `-i` le escribe a la terminal de quien corre la sonda, no a `claude`
proc elegirLaDeAbajo {sesion} { after 1500; send -i $sesion "\033\[B"; after 500; send -i $sesion "\r" }

proc sesion {nombre respuesta archivo} {
  global dir ajustes marca S
  set pedido "Corré con la herramienta Bash exactamente este comando, una sola vez y sin cambiarlo: touch $archivo # $marca"
  set timeout 120
  spawn claude --dangerously-skip-permissions --settings $ajustes $pedido
  set vio 0
  # la confianza en la carpeta se da sólo para la carpeta temporal de la sonda; la opción marcada es «No», va la de abajo
  # la sesión le pregunta a la terminal quién es (`ESC[c`) y no lee teclas hasta tener respuesta: se contesta como una VT220.
  # La pregunta llega DESPUÉS de dibujar el menú, en la misma tanda: contestarla descarta lo leído, así que el menú se
  # busca también en lo que traía esa tanda, no sólo en lo que llega después.
  set confianza "trust${S}(?:the${S}files${S}in${S})?this${S}folder"
  set bypass "Yes,${S}I${S}accept"
  set ventana "Do${S}you${S}want${S}to${S}proceed\\?"
  expect {
    -re "\x1b\\\[c" {
      send "\033\[?62;22c"
      set leido $expect_out(buffer)
      if {[regexp $ventana $leido]} { set vio 1 } else {
        if {[regexp $confianza $leido] || [regexp $bypass $leido]} { elegirLaDeAbajo $spawn_id }
        exp_continue
      }
    }
    -re $bypass { elegirLaDeAbajo $spawn_id; exp_continue }
    -re $confianza { elegirLaDeAbajo $spawn_id; exp_continue }
    -re $ventana { set vio 1 }
    timeout { }
    eof { }
  }
  if {!$vio} {
    catch {close}
    if {[file exists $archivo]} { rojo "($nombre) el comando corrió sin mostrar la ventana de permiso" }
    no_medido "($nombre) la sesión no mostró la ventana de permiso en 120 s"
  }
  send -- $respuesta
  # el comando, si corre, termina en segundos; ASK_WINDOW_PROBE_WAIT acorta la espera en las pruebas de la sonda
  set espera 60
  if {[info exists ::env(ASK_WINDOW_PROBE_WAIT)]} { set espera $::env(ASK_WINDOW_PROBE_WAIT) }
  set limite [expr {[clock seconds] + $espera}]
  while {[clock seconds] < $limite && ![file exists $archivo]} { after 500 }
  send "\003"; after 300; send "\003"
  catch {close}
  catch {wait}
}

set si [file join $dir si.txt]
set no [file join $dir no.txt]
cd $dir
sesion "con Sí" "\r" $si
if {![file exists $si]} { rojo "con «Sí» el comando no corrió" }
sesion "con No" "\033" $no
if {[file exists $no]} { rojo "con «No» el comando corrió igual" }
puts "\nVERDE: la ventana apareció en modo bypass; con «Sí» corrió y con «No» no ($dir)"
exit 0
