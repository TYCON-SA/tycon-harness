     "setup": [
      "git init -q .",
      "mkdir -p ${SANDBOX_HOME}/.claude/.tycon-pipeline/active",
      "cp _marker.json ${SANDBOX_HOME}/.claude/.tycon-pipeline/active/adv-b3.json",
      "node ${SKILLS}/skills/tycon-pipeline/scripts/marker.js mark-adversarial-skipped --files scripts/x.js > sk.out 2> sk.err; echo \"rc=$?\" > rc.txt"
     ],
     "stdin": {
      "session_id": "adv-b3",
      "tool_name": "Bash",
      "tool_input": {
       "command": "echo"
      }
     },
     "expect": {
      "file_contains": [
       {
        "path": "${FIXTURE}/rc.txt",
        "re": "rc=0"
       },
       {
        "path": "${SANDBOX_HOME}/.claude/.tycon-pipeline/active/adv-b3.json",
        "re": "\"adversarialSkip\""
       },
       {
        "path": "${SANDBOX_HOME}/.claude/.tycon-pipeline/active/adv-b3.json",
        "re": "\"deepReviewDone\": true"
       },
       {
        "path": "${SANDBOX_HOME}/.claude/.tycon-pipeline/gates.log",
        "re": "\"name\":\"adversarial-skip\",\"status\":\"ok\""
       }
      ]
