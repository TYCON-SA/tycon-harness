{
  "hooks": [
    {
      "hook": "cover-secrets.js",
      "script": "${TCG}/scripts/hooks/cover-secrets.js",
      "event": "PostToolUse",
      "matcher": "Bash|PowerShell|Read|Grep",
      "cases": [
        {
          "id": "CoverSecretsBench_WithAndWithoutValue_CoversThenSilent-con-un-valor-tapa",
          "type": "must-emit",
          "_por_que": "Un valor real de una variable con nombre de secreto llega al modelo si el gancho no lo cambia.",
          "env": { "PRUEBA_TOKEN": "valor.inventado-para-el-banco-78" },
          "stdin": {
            "tool_name": "Bash",
            "tool_input": { "command": "env" },
            "tool_response": { "stdout": "PRUEBA_TOKEN=valor.inventado-para-el-banco-78\n", "stderr": "", "interrupted": false }
          },
          "expect": {
            "exit": 0,
            "stdout_re": ["«tapado»"],
            "stdout_not_re": ["valor.inventado-para-el-banco-78"]
          }
        },
        {
          "id": "CoverSecretsBench_WithAndWithoutValue_CoversThenSilent-sin-valor-calla",
          "type": "must-stay-quiet",
          "_por_que": "Sin un valor real en la salida el gancho no contesta nada: una clave de ejemplo sale tal cual.",
          "env": { "PRUEBA_TOKEN": "valor.inventado-para-el-banco-78" },
          "stdin": {
            "tool_name": "Bash",
            "tool_input": { "command": "ls" },
            "tool_response": { "stdout": "una salida cualquiera con ghp_ejemplo\n", "stderr": "", "interrupted": false }
          },
          "expect": { "exit": 0 }
        }
      ]
    }
  ]
}
