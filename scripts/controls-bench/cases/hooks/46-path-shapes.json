            "linux",
            "darwin"
          ],
          "setup": [
            "git init -q -b main .",
            "mkdir -p .tycon src"
          ],
          "stdin": {
            "tool_name": "Write",
            "tool_input": {
              "file_path": "${FIXTURE}/src/Foo.cs",
              "content": "class Foo {}"
            }
          },
          "expect": {
            "exit": 2,
            "file_contains": [
              {
                "path": "${SANDBOX_HOME}/.claude/.tycon-pipeline/gates.log",
                "re": "story-gate"
