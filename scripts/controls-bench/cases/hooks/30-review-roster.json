            "node -e \"const fs=require('fs');const d=process.env.SANDBOX_HOME+'/.claude/.tycon-pipeline/advisor-runs';fs.mkdirSync(d,{recursive:true});fs.writeFileSync(d+'/bench-ros5.jsonl',JSON.stringify({ts:'2026-09-01T12:00:00Z',event:'step5-start',iter:1,expected:['tycon-plugin-security-basics']})+'\\n')\""
          ],
          "stdin": {
            "session_id": "bench-ros5",
            "tool_name": "Task",
            "tool_input": {
              "subagent_type": "tycon-plugin-security-basics"
            }
          },
          "expect": {
            "file_absent": [
              "${FIXTURE}/.advisors/pipeline-runs/2.2-20260901120000/review-roster.json"
            ]
          }
        }
