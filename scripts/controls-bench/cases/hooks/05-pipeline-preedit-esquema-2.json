{
  "__doc": "Gemelos de 05-pipeline-preedit.json con el marcador nuevo (story 7.23: pasos por nombre de máquina, stepScheme 2). Cada caso es el del archivo original con el marcador traducido por la equivalencia de lib/steps.js; tiene que decidir lo mismo.",
  "hooks": [
    {
      "hook": "hook-pre-edit.js (dispatcher pre-edit)",
      "script": "${SKILLS}/skills/tycon-pipeline/scripts/hook-pre-edit.js",
      "event": "PreToolUse",
      "matcher": "Edit|Write",
      "cases": [
        {
          "id": "story-gate-pasa-con-marker-de-pipeline-esquema-2",
          "type": "must-not-block",
          "setup": [
            "git init -q -b main .",
            "mkdir -p .tycon src specs/stories",
            "printf -- '---\\nstory: \"3.1\"\\nepic: \"3\"\\nstatus: in-progress\\n---\\n# Story 3.1\\n' > specs/stories/3-1.md",
            "node -e \"const fs=require('fs');const d=process.env.SANDBOX_HOME+'/.claude/.tycon-pipeline/active';fs.mkdirSync(d,{recursive:true});fs.writeFileSync(d+'/bench-s1.json',JSON.stringify({sessionId:'bench-s1',storyId:'3.1',repoPath:process.env.FIXTURE,storyPath:process.env.FIXTURE+'/specs/stories/3-1.md',stepScheme:2,stepsCompleted:['start','validate-story','plan','approve-plan','implement','run-tests'],fileEvents:[{path:process.env.FIXTURE+'/tests/Foo.test.ts'}],lastTouch:new Date().toISOString()}))\""
          ],
          "stdin": {
            "session_id": "bench-s1",
            "tool_name": "Write",
            "tool_input": {
              "file_path": "${FIXTURE}/src/Foo.cs",
              "content": "class Foo {}"
            }
          },
          "expect": {
            "exit": 0
          }
        },
        {
          "id": "atdd-bloquea-impl-antes-que-test-esquema-2",
          "type": "must-block",
          "setup": [
            "git init -q -b main .",
            "mkdir -p src specs/stories",
            "printf -- '---\\nstory: \"3.1\"\\nepic: \"3\"\\nstatus: in-progress\\n---\\n# Story 3.1\\n\\n### Tests\\n| id | descripcion |\\n|---|---|\\n| T1 | valida x |\\n' > specs/stories/3-1.md",
            "node -e \"const fs=require('fs');const d=process.env.SANDBOX_HOME+'/.claude/.tycon-pipeline/active';fs.mkdirSync(d,{recursive:true});fs.writeFileSync(d+'/bench-s1.json',JSON.stringify({sessionId:'bench-s1',storyId:'3.1',repoPath:process.env.FIXTURE,storyPath:process.env.FIXTURE+'/specs/stories/3-1.md',stepScheme:2,stepsCompleted:['start','validate-story','plan','approve-plan'],fileEvents:[],lastTouch:new Date().toISOString()}))\""
          ],
          "stdin": {
            "session_id": "bench-s1",
            "tool_name": "Write",
            "tool_input": {
              "file_path": "${FIXTURE}/src/Foo.cs",
              "content": "class Foo {}"
            }
          },
          "expect": {
            "exit": 2,
            "stderr_re": [
              "ATDD|test"
            ]
          }
        },
        {
          "id": "atdd-pasa-si-ya-hay-test-tocado-esquema-2",
          "type": "must-not-block",
          "setup": [
            "git init -q -b main .",
            "mkdir -p src specs/stories",
            "printf -- '---\\nstory: \"3.1\"\\nepic: \"3\"\\nstatus: in-progress\\n---\\n# Story 3.1\\n\\n### Tests\\n| id | descripcion |\\n|---|---|\\n| T1 | valida x |\\n' > specs/stories/3-1.md",
            "node -e \"const fs=require('fs');const d=process.env.SANDBOX_HOME+'/.claude/.tycon-pipeline/active';fs.mkdirSync(d,{recursive:true});fs.writeFileSync(d+'/bench-s1.json',JSON.stringify({sessionId:'bench-s1',storyId:'3.1',repoPath:process.env.FIXTURE,storyPath:process.env.FIXTURE+'/specs/stories/3-1.md',stepScheme:2,stepsCompleted:['start','validate-story','plan','approve-plan'],fileEvents:[{path:process.env.FIXTURE+'/tests/Foo.test.ts'}],lastTouch:new Date().toISOString()}))\""
          ],
          "stdin": {
            "session_id": "bench-s1",
            "tool_name": "Write",
            "tool_input": {
              "file_path": "${FIXTURE}/src/Foo.cs",
              "content": "class Foo {}"
            }
          },
          "expect": {
            "exit": 0
          }
        }
      ]
    }
  ]
}
