{
  "hooks": [
    {
      "hook": "on-pre-commit.js",
      "script": "${SKILLS}/skills/tycon-pipeline/scripts/on-pre-commit.js",
      "event": "PreToolUse",
      "matcher": "Bash",
      "cases": [
        {
          "id": "freno-de-guardar-commit-de-la-corrida-sin-ok-frena",
          "type": "must-block",
          "_por_que": "el ok de guardar lo da una persona con su firma: un commit de la corrida sin la constancia vigente frena en el gancho, no en lo que el agente se acuerde de correr.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "git add -A && git commit -m 'feat: x'" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "approve-save"] }
        },
        {
          "id": "freno-de-guardar-pedido-de-la-corrida-sin-ok-frena",
          "type": "must-block",
          "_por_que": "un pedido se juzga contra toda la corrida: sin la constancia, abrirlo frena igual que el commit.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "gh pr create --fill" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "toda la corrida"] }
        },
        {
          "id": "freno-de-guardar-pedido-con-el-alias-que-declara-el-conector-frena",
          "type": "must-block",
          "_por_que": "los pedidos salen de lo que declaran los conectores de plataforma: el alias que declara el de GitHub frena como la forma larga.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "gh pr new --fill" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "«gh pr new»"] }
        },
        {
          "id": "freno-de-guardar-gemelo-mirar-un-pedido-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "el gemelo: un comando del conector que no crea ni mergea un pedido (mirarlo) no frena en la misma corrida sin ok.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "gh pr view 3" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-gemelo-leer-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "el gemelo: en la misma corrida sin ok, un comando que no guarda (mirar el estado del repo) no frena.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "git status --short" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-push-de-la-corrida-sin-ok-frena",
          "type": "must-block",
          "_por_que": "el push de la corrida va con el mismo ok que el commit: sin la constancia, frena.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "git push origin HEAD" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "git push"] }
        },
        {
          "id": "freno-de-guardar-merge-del-pedido-sin-ok-frena",
          "type": "must-block",
          "_por_que": "mergear un pedido también guarda: sin la constancia de la corrida, frena.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "gh pr merge 3 --squash" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "gh pr merge"] }
        },
        {
          "id": "freno-de-guardar-pedido-de-azure-sin-ok-frena",
          "type": "must-block",
          "_por_que": "el pedido de Azure DevOps cuenta igual que el de GitHub.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "az repos pr create --title t --source-branch b" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "az repos pr create"] }
        },
        {
          "id": "freno-de-guardar-commit-desde-otra-carpeta-frena",
          "type": "must-block",
          "_por_que": "cambiar de carpeta o apuntar git a otra no saca el commit de la corrida.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js && mkdir -p sub",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "cd sub && git -C .. commit -am x" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "git commit"] }
        },
        {
          "id": "freno-de-guardar-commit-dentro-de-otro-shell-frena",
          "type": "must-block",
          "_por_que": "envolver el commit en otro shell no lo esconde.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "bash -lc 'git commit -am x'" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "git commit"] }
        },
        {
          "id": "freno-de-guardar-comando-desde-una-variable-frena",
          "type": "must-block",
          "_por_que": "un comando armado desde una variable no se puede leer: dentro de una corrida frena.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "G=git; $G commit -am x" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "no pude leer este comando"] }
        },
        {
          "id": "freno-de-guardar-shell-que-lee-de-un-tubo-frena",
          "type": "must-block",
          "_por_que": "lo que no se lee con certeza frena dentro de una corrida: un shell que lee su guion de un tubo, guarde o no.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "echo 'git commit -am x' | sh" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "no pude leer este comando"] }
        },
        {
          "id": "freno-de-guardar-el-texto-no-repite-el-comando",
          "type": "must-block",
          "_por_que": "el texto del freno nombra la forma y el repo, nunca el comando: un comando puede traer una credencial.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "git push https://bench:SECRETO-DE-PRUEBA@example.com/r.git HEAD" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "git push"], "stderr_not_re": ["SECRETO-DE-PRUEBA"] }
        },
        {
          "id": "freno-de-guardar-cerrada-sin-ok-frena-fuera-de-la-corrida",
          "type": "must-block",
          "_por_que": "cerrar la corrida con --discard no es la salida del ok: el registro de la sesión sigue frenando el commit de ese repo fuera de la corrida.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/save-closed\"; printf '[{\"story\":\"9.9\",\"repos\":[\"%s\"],\"ts\":\"2026-10-25T10:00:00.000Z\"}]' \"$(pwd -P)\" > \"$S/save-closed/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "git push origin HEAD" } },
          "expect": { "exit": 2, "stderr_re": ["OK DE GUARDAR", "cerró sin ok de guardar"] }
        },
        {
          "id": "freno-de-guardar-gemelo-fuera-de-una-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "el gemelo: fuera de una corrida y sin registro, el push pasa como antes.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js"
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "git push origin HEAD" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-ls-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "lo común dentro de una corrida no frena: no guarda nada.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "ls -la" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-ll-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "un alias de la sesión que no es de git (ll) se resuelve con la copia del shell y no da duda.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\"",
            "mkdir -p \"$HOME/.claude/shell-snapshots\" && printf \"alias -- ll='ls -lh'\\nalias -- gst='git status'\\n\" > \"$HOME/.claude/shell-snapshots/snapshot-zsh-1-bench.sh\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "ll src" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-cat-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "lo común dentro de una corrida no frena: no guarda nada.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "cat app.js" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-grep-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "lo común dentro de una corrida no frena: no guarda nada.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "grep -rn x ." } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-npm-test-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "correr las pruebas, con su salida unida y recortada, no guarda nada.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "npm test -- app.test.js 2>&1 | tail -5" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-git-status-por-alias-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "un alias de la sesión que resuelve a git status (gst) se lee y no guarda.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\"",
            "mkdir -p \"$HOME/.claude/shell-snapshots\" && printf \"alias -- ll='ls -lh'\\nalias -- gst='git status'\\n\" > \"$HOME/.claude/shell-snapshots/snapshot-zsh-1-bench.sh\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "gst" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-git-log-en-la-corrida-pasa",
          "type": "must-not-block",
          "_por_que": "lo común dentro de una corrida no frena: no guarda nada.",
          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": { "session_id": "bench-freno", "tool_name": "Bash", "tool_input": { "command": "git log --oneline -3" } },
          "expect": { "exit": 0 }
        },
        {
          "id": "freno-de-guardar-comun-git-diff-en-la-corrida-pasa",
          "type": "must-not-block",
