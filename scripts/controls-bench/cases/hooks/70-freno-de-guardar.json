          "setup": [
            "git init -q -b main . && echo hola > LEEME.md && git add -A && git -c user.email=bench@example.com -c user.name=bench commit -qm base && echo x > app.js",
            "S=\"$HOME/.claude/.tycon-pipeline\"; mkdir -p \"$S/active\"; printf '{\"storyId\":\"9.9\",\"startedAt\":\"2026-10-25T10:00:00.000Z\",\"repoPath\":\"%s\",\"sessionId\":\"bench-freno\",\"stepsCompleted\":[\"start\",\"implement\"],\"stepsPending\":[\"prepare-commit\"]}' \"$(pwd -P)\" > \"$S/active/bench-freno.json\""
          ],
          "stdin": {
            "session_id": "bench-freno",
            "tool_name": "Bash",
            "tool_input": {
              "command": "git add -A && git commit -m 'feat: x'"
            }
          },
          "expect": {
            "stdout_re": [
              "\"permissionDecision\":\"ask\"",
              "«git commit»"
            ]
          }
