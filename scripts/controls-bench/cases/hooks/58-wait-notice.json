          },
          "setup": [
            "mkdir -p \"$SANDBOX_HOME/.claude/.tycon-pipeline/active\" && printf '%s' '{\"storyId\":\"9.9\",\"stepsPending\":[5,6,8]}' > \"$SANDBOX_HOME/.claude/.tycon-pipeline/active/bench-w2.json\""
          ]
        },
        {
