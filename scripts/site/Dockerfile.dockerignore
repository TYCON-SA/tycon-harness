# Dockerfile.dockerignore — lo que entra a la imagen del sitio (story 2.23, AC 3). Lo lee BuildKit (docker buildx build)
# para scripts/site/Dockerfile. Lista blanca: todo afuera, salvo lo que el sitio ejecuta; después, por las dudas, afuera
# las pruebas, la historia de git y todo lo que tenga forma de secreto (las líneas de abajo ganan sobre las de arriba).
*
!version.json
!LICENSE
!NOTICE
!.tycon-release.json
!scripts/site/
!guides/sitio-de-la-organizacion.md
!guides/sitio-de-la-organizacion.en.md
!guides/sitio-de-la-organizacion/capturas/
!scripts/lib/
!scripts/metrics/
!scripts/nightly/dashboard/
!scripts/setup/harness/
!scripts/setup/install-effects.json
!scripts/ci/check-product-parity.js
!scripts/ci/legacy-options.js
!skills/tycon-pipeline/scripts/lib/
!skills/tycon-pipeline/steps/
!packs/
!agents/
scripts/tests
.git
**/*.pem
**/*.key
**/*.pfx
**/.env
**/*.env
**/node_modules
**/*.test.js
**/*.test.sh
