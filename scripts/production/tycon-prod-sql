#!/bin/bash -p
# tycon-prod-sql — LA puerta: la única forma de consultar una base de producción.
#
# POR QUÉ EXISTE (story 6.1 — guides/maintaining/incident-log.md#produccion-sin-permiso-2026-09-15): el 2026-09-15, en una sesión sobre un producto del equipo, una autorización puntual se
# estiró sola a la tarea siguiente: ~9 consultas más contra producción sin pedir permiso. Acá cada
# sentencia la aprueba una persona en un cuadro del sistema que abre LA PROPIA PUERTA (`aprobar`, más abajo),
# antes de leer la clave: así la aprobación no depende de cómo se la llamó. Un guion guardado que llama a la
# puerta no pasa por la regla `ask` de Claude Code, que mira el texto del comando; el cuadro propio sí lo ve.
# Es la ÚNICA ventana: la configuración administrada no pregunta por la puerta, porque su permiso no agregaba control
# (lo que corre sin el cuadro propio lo prueba tycon-prod-sql.test.sh, «sin el cuadro no se hace nada») y duplicaba
# las ventanas. El freno `prod-access-guard.js` prohíbe cualquier otro camino a esa base. El cuadro se abre sólo en la
# pantalla de la Mac, nunca por SSH. Una sentencia pedida por una sesión de Claude Code no lo abre: la aprueba el click
# del dueño en el cuadro de opciones de la sesión (`aprobar_en_la_sesion`, más abajo). Un solo cuadro por sentencia.
#
# LA CONTRASEÑA NUNCA PASA POR LA CONVERSACIÓN: vive en un llavero propio
# (~/Library/Keychains/tycon-prod.keychain-db), la saca esta puerta y viaja al cliente de base por
# SQLCMDPASSWORD, sólo en el entorno del proceso hijo. Nunca por argumento, nunca en la salida.
#
# `bash -p` A PROPÓSITO: en modo privilegiado bash ignora BASH_ENV, ENV y SHELLOPTS heredados, así que
# una variable puesta en el entorno no puede ejecutar código antes que la puerta ni prender `xtrace`
# para que imprima la contraseña (revisores del Step 5, 2026-09-15).
#
# FORMATO FIJO A PROPÓSITO (AC 18): junta el error con la salida, corta filas e imprime `rc=`. Así el
# uso real no necesita tuberías ni redirecciones, que la forma canónica prohíbe.
#
# Formas aceptadas:
#   tycon-prod-sql <host> '<sentencia>' [--max-rows N]
#   tycon-prod-sql --reclassify <host>       baja un host a no-producción (lo aprobás en el cuadro)
#   tycon-prod-sql --verify                   revisa la instalación y la entrada del Llavero, sin leer el secreto
#   tycon-prod-sql --load-key <host>          deja el archivo para cargar la clave, sin consultar nada
#   tycon-prod-sql --open-firewall <host>     abre la regla de firewall de esta máquina en un Azure SQL de producción
#   tycon-prod-sql --close-firewall <host>    la cierra (el hook de fin de sesión agrega --session <id>)
#   tycon-prod-sql --locks                    dice qué servidores de producción tienen el candado de Azure (sólo lee)
#   tycon-prod-sql --delete-group <grupo>     borra un grupo de recursos que puede probar que no es de producción
#   tycon-prod-sql --help                     las formas y el camino de emergencia; no toca nada
#   tycon-prod-sql --azure <az sin «az»>      un cambio de administración de Azure (alertas, tamaño o plan), con cuadro;
#                                             sus lecturas (list, show) sin cuadro
#
# `--azure` RECIBE CADA ARGUMENTO DE `az` TAL CUAL, en su lugar (nunca un texto que se parte o se evalúa), y sólo corre
# las operaciones de la lista de abajo: lo que no está, no tiene camino aprobado y se le deja a la persona. El cuadro
# muestra el comando entero, y un argumento con «@» (az leería un archivo que el cuadro no muestra) no pasa.
#
# EL FIREWALL Y SU LÍMITE, ESCRITO: abrir y cerrar llaman a `az`, que NO es un binario de root con huella (es del
# usuario: Homebrew o el instalador de Microsoft). Rompe la regla de «sólo binarios de root» y se acepta con tres
# condiciones: (a) `az` se busca en una lista fija de rutas absolutas, nunca en el PATH; (b) nunca recibe la clave de
# la base ni nada del Llavero (corre con un entorno limpio); (c) sólo se le piden `account list`, `sql server list`,
# `sql server show` y `sql server firewall-rule show|create|update|delete`, siempre con el nombre fijo `tycon-gate-<id de la máquina>`,
# y, al cerrar una regla sin lugar anotado, la consulta de si el nombre del servidor está libre (`rest` a
# `Microsoft.Sql/checkNameAvailability`, que sólo lee).
# La regla es de UNA sola IP, la que el propio Azure SQL informa al rechazar la conexión (error 40615): no se llama a
# ningún servicio externo para saberla.
#
# Salidas: 0 = corrió · 2 = no se puede (forma inválida, host que no es producción, algo que no
# verifica) · 3 = falta la clave (deja el .command para cargarla)
#
# TYCON_PROD_ROOT: raíz de sistema alternativa. Se honra SÓLO si /opt/tycon no existe de verdad, o
# sea nunca en una máquina con el freno instalado: es para las pruebas, no un interruptor.
set -uo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin     # nada del PATH del usuario decide lo que corre la puerta

INSTALADO=0; [ -d /opt/tycon ] && INSTALADO=1
RAIZ=""
if [ "$INSTALADO" = 0 ] && [ -n "${TYCON_PROD_ROOT:-}" ]; then RAIZ="$TYCON_PROD_ROOT"; fi
AQUI="$(cd "$(dirname "$0")" && pwd)"
SECURITY="$RAIZ/usr/bin/security"
CLIENTE="$RAIZ/opt/tycon/bin/sqlcmd"
HUELLAS="$RAIZ/opt/tycon/huellas.json"
# la carpeta del estado: la regla de tycon-home.js stateDir (si existe ~/.tycon/state, la máquina vive ahí; story 8.23, tanda D)
_ESTADO="$HOME/.claude/.tycon-pipeline"; [ -d "$HOME/.tycon/state" ] && _ESTADO="$HOME/.tycon/state"
REGISTRO="$_ESTADO/production.log"
LLAVERO_PROPIO="$HOME/Library/Keychains/tycon-prod.keychain-db"
MAX_FILAS=50

# El intérprete y el índice: instalada, SÓLO los de /opt/tycon (de root, con huella). En el repo
# (pruebas, desarrollo) se usa lo que está al lado y el node disponible.
if [ "$INSTALADO" = 1 ]; then
  NODE="/opt/tycon/bin/node"
  INDICE_JS="/opt/tycon/production/production-index.js"
  PLANTILLA="/opt/tycon/production/load-key.command.template"
else
  NODE="$RAIZ/opt/tycon/bin/node"
  [ -x "$NODE" ] || NODE="$(PATH="${TYCON_PROD_TEST_PATH:-/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin}" command -v node || true)"
  INDICE_JS="$AQUI/production-index.js"
  PLANTILLA="$AQUI/load-key.command.template"
fi

muere(){ printf '%s\n' "$1" >&2; exit "${2:-2}"; }
huella_de(){ shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1; }
duenio_de(){ stat -f '%Su' "$1" 2>/dev/null; }
huella_esperada(){ # $1 = ruta canónica (/opt/tycon/…) — grep, NUNCA sed: la clave es una ruta con barras
  [ -f "$HUELLAS" ] || return 1
  grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[a-f0-9]\{64\}\"" "$HUELLAS" | grep -o '[a-f0-9]\{64\}' | head -1
}
# un binario de root: existe, es de root (instalada) y su huella coincide con la de referencia
verificar_binario(){ # $1 = ruta real, $2 = ruta canónica, $3 = nombre para el mensaje
  [ -x "$1" ] || muere "no está $3 de root ($2). NO uso el del PATH: un impostor se llevaría la contraseña. Reinstalá el freno."
  if [ "$INSTALADO" = 1 ]; then
    [ "$(duenio_de "$1")" = "root" ] || muere "$3 ($2) no es de root: alguien lo reemplazó. Reinstalá el freno."
    local esperada; esperada="$(huella_esperada "$2")" || esperada=""
    [ -n "$esperada" ] || muere "no hay huella de referencia para $3: no lo ejecuto a ciegas. Reinstalá el freno."
    [ "$(huella_de "$1")" = "$esperada" ] || muere "$3 no coincide con la huella que dejó el instalador: alguien lo cambió."
  elif [ -f "$HUELLAS" ]; then
    local esperada; esperada="$(huella_esperada "$2")" || esperada=""
    if [ -n "$esperada" ] && [ "$(huella_de "$1")" != "$esperada" ]; then
      muere "$3 no coincide con la huella de referencia: alguien lo cambió."
    fi
  fi
}

# ── quién puede LEER una entrada del Llavero ──────────────────────────────────────────────────
# 🔴 Lo que gatea la lectura es la entrada de autorización que dice `decrypt`, y una entrada creada
# con `-A` la deja en `applications: <null>`, o sea CUALQUIER programa, sin cuadro. La versión
# anterior juntaba las líneas numeradas de TODAS las entradas: con `-A` no hay ninguna línea
# numerada, así que la entrada más peligrosa de todas salía «limpia» (medido en un llavero
# descartable el 2026-09-15 y reproducido; revisores del Step 5).
# Imprime, para el servicio pedido: «CUALQUIERA», «AJENA <ruta>» por cada app que no sea la del
# sistema, o nada si sólo confía en /usr/bin/security.
quien_lee(){ # $1 = volcado de dump-keychain, $2 = nombre del servicio
  printf '%s\n' "$1" | awk -v target="$2" '
    /^keychain: / { svce=""; next }
    /^[ \t]*"svce"<blob>="/ { l=$0; sub(/^[^=]*="/,"",l); sub(/"[ \t]*$/,"",l); svce=l; next }
    /^[ \t]*entry [0-9]+:/ { gate=0; inapps=0; next }
    # `any` incluye decrypt: una entrada así también puede LEER, y mirar sólo la palabra «decrypt»
    # la dejaba invisible (revisión final del Step 5, 2026-09-15).
    /authorizations \(/ { gate = ($0 ~ /(^| )(decrypt|any)( |$)/) ? 1 : 0; inapps=0; next }
    /applications: <null>/ { if (gate && svce == target) print "CUALQUIERA"; next }
    /applications \([0-9]+\):/ { inapps = gate; next }
    /^[ \t]*[0-9]+: / {
      if (inapps && svce == target) {
        l=$0; sub(/^[ \t]*[0-9]+: /,"",l); sub(/ \(OK\)$/,"",l)
        if (l != "/usr/bin/security") print "AJENA " l
      }
      next
    }
  '
}
# los servicios que hay en el llavero propio (para --verify)
servicios_del_llavero(){ printf '%s\n' "$1" | sed -n 's/^[[:space:]]*"svce"<blob>="\(.*\)"[[:space:]]*$/\1/p' | sort -u; }

HOST_VALIDO='^[A-Za-z0-9][A-Za-z0-9._-]*$'
LLAVERO_VALIDO='^tycon-prod-[A-Za-z0-9._-]+$'
BASE_VALIDA='^[A-Za-z0-9_][A-Za-z0-9_.-]*$'       # el mismo charset que exige lint-production-json.js

# Lo que no se pudo anotar se dice en rojo, sin cambiar la salida: algo que corrió sin constancia no puede pasar callado.
sin_registro(){ printf '🔴 no pude anotar esta operación en el registro de producción (%s): quedó sin constancia.\n' "$1" >&2; }
anotar(){ # $1 = json parcial (sólo valores ya validados: host y llavero pasaron su charset)
  mkdir -p "$(dirname "$REGISTRO")" 2>/dev/null || { sin_registro "$REGISTRO"; return 0; }
  printf '{"ts":"%s",%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" 2>/dev/null >> "$REGISTRO" || sin_registro "$REGISTRO"
}

# ── el cuadro propio: la aprobación de una persona, pedida por la puerta ──────────────────────
# La consulta, `--reclassify` y `--open-firewall` lo piden antes de leer la clave, de tocar el índice o de llamar a `az`;
# `--delete-group`, cuando ya probó que el grupo no tiene nada de producción y antes de pedir el borrado.
# Sin respuesta, sin sesión gráfica o sin el programa del cuadro, la puerta sale 2: falla cerrada. El programa se busca
# bajo la raíz, como `security`, y corre con un entorno limpio y un tope de tiempo propio.
OSASCRIPT="$RAIZ/usr/bin/osascript"
LAUNCHCTL="$RAIZ/bin/launchctl"
CUADRO_ESPERA=120
# Lo que el cuadro muestra entero: una sentencia más larga se rechaza antes de abrirlo, nunca se muestra cortada.
CUADRO_MAX_CARACTERES=1200; CUADRO_MAX_RENGLONES=20; CUADRO_COLUMNAS=60
# 🔴 El guion de AppleScript es FIJO: lo que se aprueba viaja como argumento (`argv`), nunca pegado al código. Una
# sentencia con comillas o con `" & do shell script "…" & "` se muestra tal cual y no se ejecuta.
CUADRO_GUION=(
  -e 'on run argv'
  -e 'display dialog (item 1 of argv) with title "Producción: ¿lo aprobás?" buttons {"Rechazar", "Aprobar"} default button "Rechazar" with icon caution giving up after 120'
  -e 'end run'
)
# 🔴 El cliente corre lo aprobado y nada más. go-sqlcmd lee su entorno: SQLCMDINI es un archivo de SQL que ejecuta al
# arrancar (también con -Q), y SQLCMDDBNAME o SQLCMDSERVER cambian a dónde va. Heredarlos dejaría correr algo que el
# cuadro no mostró, así que la puerta se los saca a sí misma antes de hacer nada.
unset SQLCMDINI SQLCMDDBNAME SQLCMDSERVER SQLCMDUSER
for v in $(compgen -e); do case "$v" in SQLCMD*) unset "$v" ;; esac; done
APROBACION=""   # el campo que suma el registro de lo aprobado

# ── quién pide: la carpeta y la sesión, en la primera línea del cuadro ─────────────────────────
# Con dos sesiones pidiendo a la vez, la persona tiene que saber de cuál viene cada cuadro. La carpeta es la
# del comando (las dos últimas partes) y la sesión, la que Claude Code pone en el entorno de la consola. Un subagente no
# llega acá: lo frena el freno (`prod-access-guard.js`), que es el único que sabe si llama un subagente, porque el
# entorno de su consola es igual al de la sesión principal (medido en Claude Code 2.1.312).
quien_pide(){
  local carpeta sesion
  # las dos últimas partes; lo que no sea una letra latina, un dígito o `._ /-` sale como «?» (un carácter invisible o
  # de dirección haría ver otra carpeta)
  carpeta="$(/usr/bin/perl -CSA -e '
    my @p = grep { length } split m{/}, $ARGV[0]; my $c = join "/", @p[($#p > 0 ? $#p - 1 : 0) .. $#p];
    $c =~ s/[^A-Za-z0-9._ \/\x{C0}-\x{17F}-]/?/g; print substr($c, 0, 60)' "$PWD" 2>/dev/null)"
  [ -n "$carpeta" ] || carpeta="(sin carpeta)"
  sesion="${CLAUDE_CODE_SESSION_ID:-}"
  if [[ "$sesion" =~ $SESION_VALIDA ]]; then printf 'Pide: %s · sesión %s (principal)' "$carpeta" "${sesion:0:8}"
  elif [ -n "${CLAUDECODE:-}" ]; then printf 'Pide: %s · una sesión de Claude Code sin identificador' "$carpeta"
  else printf 'Pide: %s · una terminal, fuera de Claude Code' "$carpeta"; fi
}

# ── un cuadro por vez ─────────────────────────────────────────────────────────────────────────
# Una ráfaga de consultas no apila cuadros: la persona contesta de a uno. El turno es un archivo con el número de la
# puerta que lo tiene y quién pide: el que lo crea abre su cuadro, los demás esperan a que se conteste, hasta un tope, y
# si se vence salen 2 diciendo quién tiene el cuadro abierto. Un turno cuyo dueño ya no corre, o más viejo que lo que
# puede durar un cuadro, se da por abandonado y se toma.
# 🔴 Se crea con `noclobber` (bash abre el archivo con O_EXCL: lo decide el sistema operativo), no con `mkdir`: el
# `mkdir` de las herramientas en Rust de algunas distribuciones (uutils) no falla si la carpeta aparece entre que mira y
# la crea, y tres puertas a la vez abrían tres cuadros (medido en la CI de Linux, Ubuntu 26.04).
TURNO="$_ESTADO/production-dialog.turn"
# la espera se acorta sólo en las pruebas (sin el freno instalado), como TYCON_PROD_ROOT
TURNO_ESPERA=90
if [ "$INSTALADO" = 0 ] && [[ "${TYCON_PROD_TEST_DIALOG_WAIT:-}" =~ ^[0-9]+$ ]]; then TURNO_ESPERA="$TYCON_PROD_TEST_DIALOG_WAIT"; fi
TENGO_TURNO=0
# crea el archivo $1 con $2 adentro sólo si no existía: sale 0 si lo creó esta puerta
crear_solo_si_no_existe(){ ( set -o noclobber; printf '%s' "$2" > "$1" ) 2>/dev/null; }
pid_del_turno(){ head -n 1 "$TURNO" 2>/dev/null; }
soltar_turno(){ [ "$TENGO_TURNO" = 1 ] && [ "$(pid_del_turno)" = "$$" ] && rm -f "$TURNO" 2>/dev/null; TENGO_TURNO=0; return 0; }
trap soltar_turno EXIT
# una puerta terminada por señal también suelta su turno: sin esto bash sale sin correr el trap de EXIT
trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
# cuándo se tocó una carpeta, en segundos; si no se puede leer, ahora. Primero `stat -c %Y` (Linux: GNU y uutils), que en
# macOS sale con error y sin nada en la salida; después `stat -f %m` (macOS). Al revés no: en Linux `stat -f` habla del
# sistema de archivos, y lo que imprime puede ser un número que no es la fecha. Y una fecha sin sentido (antes de 2001 o
# en el futuro) cuenta como ahora: con una fecha vieja de mentira, un turno vivo se daba por abandonado y se lo robaban
segundos_de(){
  local s ahora
  ahora="$(date +%s)"
  s="$(stat -c %Y "$1" 2>/dev/null)"; [[ "$s" =~ ^[0-9]+$ ]] || s="$(stat -f %m "$1" 2>/dev/null)"
  if ! [[ "$s" =~ ^[0-9]+$ ]] || [ "$s" -lt 1000000000 ] || [ "$s" -gt $(( ahora + 60 )) ]; then s="$ahora"; fi
  printf '%s' "$s"
}
turno_abandonado(){
  local pid edad
  pid="$(pid_del_turno)"
  if [[ "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null; then return 0; fi
  edad=$(( $(date +%s) - $(segundos_de "$TURNO") ))
  # sin pid escrito todavía: recién creado; se da por abandonado sólo si pasó lo que dura un cuadro
  [ "$edad" -gt $((CUADRO_ESPERA + 30)) ]
}
tomar_turno(){ # $1 = lo que dice quién pide (para el que espera)
  mkdir -p "$(dirname "$TURNO")" 2>/dev/null
  local desde; desde=$(date +%s)
  while :; do
    # el número y quién pide van en la misma escritura que crea el archivo
    if crear_solo_si_no_existe "$TURNO" "$$
$1"; then TENGO_TURNO=1; return 0; fi
    # el turno no se puede crear: la carpeta del estado no se escribe, o en su lugar hay algo que no es un archivo. No se
    # mira si el turno existe: la puerta que lo tenía puede soltarlo entre la creación y esta línea
    if [ ! -w "$(dirname "$TURNO")" ] || { [ -e "$TURNO" ] && [ ! -f "$TURNO" ]; }; then muere "no pude crear el turno del cuadro en $(dirname "$TURNO"): sin turno no abro el cuadro ni leo la clave. Revisá que esa carpeta se pueda escribir."; fi
    # 🔴 Tomar un turno abandonado va de a una puerta, y se vuelve a mirar adentro: dos que vieron el mismo turno muerto,
    # sin esto, se llevaban también el turno vivo que la primera acababa de crear, y quedaban dos cuadros abiertos.
    if turno_abandonado && crear_solo_si_no_existe "$TURNO.rescate" "$$"; then
      turno_abandonado && rm -f "$TURNO"
      rm -f "$TURNO.rescate" 2>/dev/null
      continue
    fi
    # el candado del rescate se tiene unos milisegundos: uno más viejo que 10 s es de una puerta que murió adentro
    if [ -f "$TURNO.rescate" ] && [ $(( $(date +%s) - $(segundos_de "$TURNO.rescate") )) -gt 10 ]; then
      rm -f "$TURNO.rescate" 2>/dev/null
    fi
    if [ $(( $(date +%s) - desde )) -ge "$TURNO_ESPERA" ]; then
      # lo escribió otra puerta con quien_pide(), ya saneado: acá sólo se le sacan los caracteres de control
      local otro; otro="$(tail -n +2 "$TURNO" 2>/dev/null | tr -d '\000-\037\177' | head -c 200)"
      anotar "\"host\":\"$HOST\",\"accion\":\"sin-turno\",\"exit\":2"
      muere "ya hay un cuadro de producción abierto esperando respuesta${otro:+ ($otro)} y la puerta abre uno por vez. Esperé ${TURNO_ESPERA} s y no se contestó: no abrí otro ni leí la clave. Que la persona conteste ese cuadro, y después volvé a intentar, de a una consulta por vez."
    fi
    sleep 1
  done
}

aprobar(){ # $1 = lo que muestra el cuadro, $2 = la forma (consulta | reclasificar | open-firewall | borrar-grupo)
  # SSH: el cuadro se abriría en la pantalla de la Mac, donde quizá no hay nadie, o no se abriría
  if [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ] || [ "$("$LAUNCHCTL" managername 2>/dev/null)" != Aqua ]; then
    muere "el cuadro de producción necesita la sesión de la Mac: abrí la terminal en la Mac, no por SSH"
  fi
  [ -x "$OSASCRIPT" ] || muere "no encuentro el programa del cuadro de aprobación ($OSASCRIPT): sin cuadro no se aprueba nada, así que no sigo."
  local respuesta pide salida=0 que motivo causa
  pide="$(quien_pide)"
  tomar_turno "$pide"
  respuesta="$(env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin LANG=en_US.UTF-8 \
    /usr/bin/perl -e 'alarm shift @ARGV; exec @ARGV or exit 127' "$((CUADRO_ESPERA + 10))" "$OSASCRIPT" "${CUADRO_GUION[@]}" "$pide

$1" 2>/dev/null)" || { salida=$?; respuesta=""; }
  soltar_turno
  # 🔴 Al vencer, `osascript` sale 0 con «gave up:true»: la salida 0 sola no es una aprobación. Vale sólo esta respuesta exacta.
  [ "$respuesta" = "button returned:Aprobar, gave up:false" ] && { APROBACION=',"aprobacion":"cuadro-propio"'; return 0; }
  # Lo que no aprueba se dice con su causa: con una frase para las tres, quien pide no sabe si alguien vio el cuadro. Se
  # reconocen sólo las dos respuestas exactas; lo que no se entiende cuenta como un cuadro que no se pudo abrir.
  [ "$2" = consulta ] && que=sentencia || que=operación
  case "$respuesta" in
    "button returned:, gave up:true")
      motivo=vencido
      causa="el cuadro se venció a los ${CUADRO_ESPERA} s sin respuesta. Si la puerta corrió de fondo, nadie lo vio: correla en primer plano, con un tope de 5 minutos, y avisale antes a la persona qué cuadro va a aparecer" ;;
    "button returned:Rechazar, gave up:false")
      motivo=rechazado
      causa="apretó «Rechazar» en el cuadro" ;;
    *)
      motivo=sin-cuadro
      if [ "$salida" = 142 ]; then causa="el programa del cuadro no contestó en $((CUADRO_ESPERA + 10)) s y se cortó"
      elif [ "$salida" = 127 ]; then causa="no se pudo correr el programa del cuadro ($OSASCRIPT)"
      elif [ "$salida" != 0 ]; then causa="el programa del cuadro salió con el código $salida"
      else causa="el programa del cuadro contestó algo que la puerta no entiende"; fi
      causa="el cuadro no se pudo abrir ($causa)" ;;
  esac
  anotar "\"host\":\"$HOST\",\"accion\":\"rechazada\",\"motivo\":\"$motivo\",\"forma\":\"$2\",\"exit\":2"
  muere "la persona no aprobó esta $que: $causa. No se leyó la clave ni se cambió nada."
}

# ── la sentencia pedida por una sesión: el click del dueño en el cuadro de opciones de la sesión ──────────────
# El cuadro del sistema se ve sólo en la pantalla de la Mac: quien sigue la sesión desde el celular o la app no lo ve y la
# consulta se vence. Pedida por una sesión de Claude Code, la sentencia la aprueba un click del dueño en el cuadro de
# opciones de esa sesión, verificado como las firmas del dueño (session-approval.js, owner-approvals.js `buscar`), y la
# puerta NO abre el cuadro del sistema: un solo cuadro por sentencia. Sin click vigente, imprime la pregunta exacta y
# sale 2 sin leer la clave; con el click, la sesión repite el mismo comando y la puerta corre. La verificación es código
# del arnés, no de root: la misma seguridad que las firmas de controles (guides/production-with-permission.md).
en_una_sesion(){ [ -n "${CLAUDECODE:-}${CLAUDE_CODE_SESSION_ID:-}" ]; }
APROBAR_JS=""
if [ "$INSTALADO" = 0 ]; then
  APROBAR_JS="${TYCON_PROD_TEST_APPROVAL_JS:-$AQUI/session-approval.js}"
fi
aprobar_en_la_sesion(){
  local sesion="${CLAUDE_CODE_SESSION_ID:-}" arnes salida=0 texto
  [[ "$sesion" =~ $SESION_VALIDA ]] || muere "la pide una sesión de Claude Code sin identificador de sesión: sin él no se puede verificar el click del dueño. Corré la puerta desde tu terminal, fuera de la sesión."
  if [ "$INSTALADO" = 1 ]; then
    arnes="$("$NODE" -e 'process.stdout.write(require(process.argv[1]).harnessDir(process.argv[2]))' /opt/tycon/setup/harness/tycon-home.js "$HOME" 2>/dev/null)" || arnes=""
    APROBAR_JS="$arnes/scripts/production/session-approval.js"
  fi
  [ -f "$APROBAR_JS" ] || muere "no encuentro el arnés para verificar el click del dueño ($APROBAR_JS): sin él no se aprueba desde la sesión. Corré la puerta desde tu terminal, fuera de la sesión."
  # con un entorno limpio, como el cuadro del sistema: una variable de la sesión no le cambia nada al verificador
  texto="$(env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin LANG=en_US.UTF-8 "$NODE" "$APROBAR_JS" --host "$HOST" --session "$sesion" --max-rows "$MAX_FILAS" -- "$SENTENCIA" 2>&1)" || salida=$?
  if [ "$salida" = 0 ]; then
    APROBACION=",\"aprobacion\":\"click-en-la-sesion\",\"sesion\":\"$sesion\""
    return 0
  fi
  if [ "$salida" = 1 ]; then
    anotar "\"host\":\"$HOST\",\"accion\":\"pide-click\",\"sesion\":\"$sesion\",\"exit\":2"
    muere "$texto"
  fi
  anotar "\"host\":\"$HOST\",\"accion\":\"rechazada\",\"motivo\":\"sin-verificar\",\"forma\":\"consulta\",\"exit\":2"
  muere "no pude verificar el click del dueño: $texto. No se leyó la clave ni se cambió nada."
}

# ── la ayuda ───────────────────────────────────────────────────────────────────────────────────
# Sin ella no había forma de descubrir las opciones: en un incidente con producción caída, el asistente no encontró
# `--open-firewall` y mandó a la persona al portal. No lee la clave, no consulta y no llama a `az`.
ayuda(){
  cat <<'AYUDA'
tycon-prod-sql — la única forma de consultar o cambiar una base de producción. Cada sentencia la aprueba una
persona en un cuadro de esta Mac; la contraseña no pasa por la conversación. Siempre con la ruta absoluta.

  /opt/tycon/bin/tycon-prod-sql <host> '<sentencia>' [--max-rows N]
        una sentencia, con cuadro: un select, o un cambio (alter database …, update …). Una por vez, sin GO.
  /opt/tycon/bin/tycon-prod-sql --open-firewall <host> [--session <id>]
        habilita la IP de esta máquina en el firewall de un Azure SQL de producción, con cuadro. Lo corre la persona
        en su terminal, a nombre de la sesión que la pidió: la regla se cierra sola cuando esa sesión termina, o a
        las 8 h aunque siga.
  /opt/tycon/bin/tycon-prod-sql --close-firewall <host>     la cierra ya
  /opt/tycon/bin/tycon-prod-sql --verify                    revisa la instalación y la clave, sin leerla
  /opt/tycon/bin/tycon-prod-sql --load-key <host>           deja en el Escritorio el archivo para cargar la clave
  /opt/tycon/bin/tycon-prod-sql --reclassify <host>         baja un host a no producción, con cuadro
  /opt/tycon/bin/tycon-prod-sql --locks                     qué servidores de producción tienen el candado de Azure
  /opt/tycon/bin/tycon-prod-sql --delete-group <grupo>      borra un grupo que se prueba que no es de producción
  /opt/tycon/bin/tycon-prod-sql --azure <comando de az sin «az»>
        un cambio de administración de un recurso de producción en Azure, con cuadro: alertas
        (monitor metrics alert create|update|delete) y tamaño o plan (sql db update, sql elastic-pool update).
        Sus lecturas (list y show, y monitor metrics list) corren sin cuadro. Lo demás no tiene camino aprobado:
        se le deja el comando a la persona para que lo corra en su terminal.

Emergencia, con producción caída (por ejemplo, la base llegó a su tope y no escribe):
  1. Probá la conexión: /opt/tycon/bin/tycon-prod-sql <host> 'select 1'
  2. Si la rechaza el firewall (40615), la persona corre en su terminal el comando que da la puerta:
     /opt/tycon/bin/tycon-prod-sql --open-firewall <host> --session <id>
  3. Mirá el estado: /opt/tycon/bin/tycon-prod-sql <host> 'select name, size/128 as mb, max_size/128 as max_mb from sys.database_files'
     (mide la base a la que entra la puerta: la «base» del servidor en su catálogo; si no la declara, master)
  4. Mitigá con una sentencia, que la persona aprueba en el cuadro, por ejemplo:
     /opt/tycon/bin/tycon-prod-sql <host> 'alter database [<base>] modify (maxsize = 250 GB)'
  5. Contale a la persona qué cambió. La regla del firewall se cierra sola.
  Detalle: guides/produccion-con-permiso.md § «Emergencia: producción caída».
AYUDA
}

# ── argumentos ────────────────────────────────────────────────────────────────────────────────
[ $# -ge 1 ] || muere "uso: tycon-prod-sql <host> '<sentencia>' [--max-rows N]  ·  --load-key <host>  ·  --reclassify <host>  ·  --verify  ·  --open-firewall <host>  ·  --close-firewall <host>  ·  --locks  ·  --delete-group <grupo>  ·  --help"
case "$1" in (--help|-h) [ $# -eq 1 ] || muere "uso: tycon-prod-sql --help  (sola)"; ayuda; exit 0 ;; esac

MODO=consulta; HOST=""; SENTENCIA=""; SESION_CIERRE=""; SESION_ABRE=""
# La consulta desde un archivo no se acepta: el cuadro de aprobación muestra el comando, no lo que trae el archivo.
# Se mira cada argumento, en cualquier posición.
for arg in "$@"; do
  case "$arg" in (--file|--file=*) muere "uso: tycon-prod-sql <host> '<sentencia>' [--max-rows N] — la consulta va en línea: el cuadro no muestra el contenido de un archivo";; esac
done
SESION_VALIDA='^[A-Za-z0-9-]{8,64}$'
case "${1:-}" in
  # Las formas del firewall aceptan SÓLO el host: ni un rango, ni una IP, ni un nombre de regla, ni una suscripción.
  # `--session <id>`, al abrir: la persona la abre en su terminal a nombre de la sesión del asistente que la pidió (la
  # regla vive lo que vive esa sesión). El freno no deja pasar esta forma a la herramienta Bash: la corre la persona
  --open-firewall) MODO=open-firewall; HOST="${2:-}"
                   if [ $# -eq 4 ] && [ "$3" = "--session" ] && [[ "$4" =~ $SESION_VALIDA ]]; then SESION_ABRE="$4"
                   elif [ $# -ne 2 ] || [ -z "$HOST" ]; then muere "uso: tycon-prod-sql --open-firewall <host> [--session <id de la sesión que la pidió>]  (sólo el host: la IP la informa Azure y la regla tiene nombre fijo)"; fi ;;
  # `--session <id>` lo pasa sólo el hook de fin de sesión: el freno no deja pasar esta forma a la herramienta Bash
  --close-firewall) MODO=close-firewall; HOST="${2:-}"
                    if [ $# -eq 4 ] && [ "$3" = "--session" ] && [[ "$4" =~ $SESION_VALIDA ]]; then SESION_CIERRE="$4"
                    elif [ $# -ne 2 ] || [ -z "$HOST" ]; then muere "uso: tycon-prod-sql --close-firewall <host>  (sólo el host: cierra la regla de esta máquina y ninguna otra)"; fi ;;
  --reclassify)   MODO=reclasificar; HOST="${2:-}"; [ $# -eq 2 ] && [ -n "$HOST" ] || muere "uso: tycon-prod-sql --reclassify <host>" ;;
  --verify)       MODO=verificar; [ $# -eq 1 ] || muere "uso: tycon-prod-sql --verify" ;;
  # los candados: sola, sin host ni nada más (mira todos los servidores de producción declarados)
  --locks)        MODO=locks; [ $# -eq 1 ] || muere "uso: tycon-prod-sql --locks  (sola: dice qué servidores de producción tienen el candado de Azure)" ;;
  # borrar un grupo: sólo el nombre; la suscripción, la confirmación y la espera las fija la puerta
  --delete-group) MODO=delete-group; GRUPO_B="${2:-}"
                  [ $# -eq 2 ] || muere "uso: tycon-prod-sql --delete-group <grupo>  (sólo el nombre del grupo: la puerta comprueba y pide el borrado)"
                  [[ "$GRUPO_B" =~ ^[A-Za-z0-9._()][A-Za-z0-9._()-]{0,89}$ ]] || muere "«${GRUPO_B}» no es un nombre de grupo de recursos (letras, dígitos, . _ ( ) -, hasta 90, sin «-» adelante)." ;;
  # 🔴 Cargar la clave SIN tener que fallar una consulta primero (2026-09-15, pedido del dev: el
  # disparador era «corré algo que falle», que es un rodeo). La clave la sigue tipeando la persona en
  # el archivo que deja la puerta: nunca pasa por la conversación ni la escribe el asistente.
  --azure)        MODO=azure; shift
                  [ $# -ge 1 ] || muere "uso: tycon-prod-sql --azure <el comando de az, sin «az»>  (cada argumento en su lugar)"
                  AZ_ARGS=("$@") ;;
  --load-key)     MODO=cargar-clave; HOST="${2:-}"; [ $# -eq 2 ] || muere "uso: tycon-prod-sql --load-key <host>" ;;
  -*)             muere "primer argumento inválido: sólo <host>, --load-key, --reclassify, --verify, --open-firewall, --close-firewall, --locks, --delete-group o --azure (todas, con su explicación: tycon-prod-sql --help)" ;;
  *)              HOST="$1"; SENTENCIA="${2:-}"
                  [ $# -ge 2 ] || muere "falta la sentencia: tycon-prod-sql <host> 'select …'"
                  if [ $# -gt 2 ]; then
                    [ $# -eq 4 ] && [ "$3" = "--max-rows" ] || muere "sólo se acepta la sentencia en línea y, opcionalmente, --max-rows N (llegaron $# argumentos)"
                    case "$4" in (*[!0-9]*|'') muere "--max-rows necesita un número";; esac
                    MAX_FILAS="$4"
                  fi ;;
esac
# el valor entero (`[[ =~ ]]`), no línea por línea: un host con un salto de línea no pasa por una de sus líneas
if [ -n "$HOST" ] && ! [[ "$HOST" =~ $HOST_VALIDO ]]; then
  muere "el host «${HOST}» no tiene forma de nombre de host."
fi

# ── la sentencia: en línea, un solo lote, sin argumentos de sqlcmd ────────────────────────────
validar_sentencia(){
  [ -n "${SENTENCIA//[[:space:]]/}" ] || muere "la sentencia está vacía: no hay nada para mostrar en el cuadro"
  case "$SENTENCIA" in
    -*) muere "la sentencia no puede empezar con «-»: no se aceptan argumentos de sqlcmd (ni -i, ni -Q, ni -v)" ;;
  esac
  if printf '%s' "$SENTENCIA" | grep -qiE '(^|[[:space:]])go([[:space:]]*$|[[:space:]]*;)'; then
    muere "la sentencia tiene un separador de lote (GO): mandá una sola, así el cuadro muestra lo que se aprueba"
  fi
  # 🔴 Los comandos del cliente (`!!` abre un shell, `:r` lee un archivo, `:out` escribe uno,
  # `:connect` va a otra base) los frena LA PUERTA, no el cliente. Antes los frenaba el `-X1` que se
  # le pasaba a sqlcmd, y eso estaba roto de dos maneras a la vez (medido el 2026-09-16, ver la nota
  # en la invocación del cliente, más abajo). Acá se frena ANTES de conectarse y sin depender del
  # dialecto de flags de ningún cliente, que es lo que se rompió.
  # Se juzga por línea: sqlcmd sólo reconoce un comando al principio de una línea.
  if printf '%s\n' "$SENTENCIA" | grep -qE '^[[:space:]]*(:|!!)'; then
    muere "la sentencia tiene un comando del cliente (una línea que empieza con «:» o «!!»): eso lee archivos o abre un shell, no consulta la base"
  fi
}
[ "$MODO" = consulta ] && validar_sentencia

# ── Azure: qué operación es, si tiene camino y cómo se ve en el cuadro ────────────────────────────────────────────
# La operación son las palabras antes de la primera opción. Los cambios piden el cuadro; las lecturas no cambian nada y
# corren sin él (quedan anotadas igual). El firewall tiene su forma propia, y lo demás no tiene camino aprobado.
validar_azure(){
  local a op="" en_op=1 texto="az"
  for a in "${AZ_ARGS[@]}"; do
    case "$a" in
      # 🔴 az lee un archivo con «@» al principio Y con «@» después del primer «=» (`--name=@ruta`, `--set clave=@ruta`;
      # «@-» lee la entrada estándar). Mirar sólo el principio dejaba que una lectura sin cuadro trajera a la conversación
      # cualquier archivo, también la credencial de Azure (pase adversarial del pedido).
      @*|*=@*) muere "un argumento trae «@» al principio o después de un «=» (${a}): az leería el contenido de un archivo, y ni el cuadro ni la persona lo ven. Escribí el valor en línea." ;;
      *"'"*) muere "un argumento tiene una comilla simple: el cuadro no lo podría mostrar tal cual. Escribilo sin ella." ;;
      # el detalle de az imprime los pedidos HTTP con sus encabezados: la credencial de la sesión llegaría a la conversación
      --debug|--verbose) muere "${a} no pasa por la puerta: az imprimiría los pedidos con sus encabezados, y la credencial de Azure llegaría a la conversación." ;;
    esac
    if [ "$en_op" = 1 ]; then case "$a" in (-*) en_op=0 ;; (*) op="${op:+$op }$a" ;; esac; fi
    if [[ "$a" =~ ^[A-Za-z0-9._:/=,+%-]+$ ]]; then texto="$texto $a"; else texto="$texto '$a'"; fi
  done
  op="$(printf '%s' "$op" | tr '[:upper:]' '[:lower:]')"
  case "$op" in
    "monitor metrics alert create"|"monitor metrics alert update"|"monitor metrics alert delete"|"sql db update"|"sql elastic-pool update")
      AZ_LECTURA=0 ;;
    "monitor metrics alert show"|"monitor metrics alert list"|"monitor metrics list"|"monitor metrics list-definitions"|"sql db show"|"sql db list"|"sql db list-usages"|"sql db list-editions"|"sql server show"|"sql server list"|"sql elastic-pool show"|"sql elastic-pool list")
      AZ_LECTURA=1 ;;
    "sql server firewall-rule"*)
      muere "la regla de firewall no va por --azure: la IP de esta máquina la habilita la persona en su terminal con /opt/tycon/bin/tycon-prod-sql --open-firewall <host> --session <id> (con cuadro, y se cierra sola cuando termina esa sesión, o a las 8 h). Otra regla no tiene camino aprobado: dejale el comando a la persona para que lo corra en su terminal." ;;
    *)
      muere "«${op:-esa operación}» no tiene camino aprobado por la puerta: dejale el comando a la persona para que lo corra en su terminal, y decile qué hace." ;;
  esac
  AZ_OP="$op"; SENTENCIA="$texto"
}
[ "$MODO" = azure ] && validar_azure

# ── el intérprete (instalada: el de root, verificado) y el índice ─────────────────────────────
[ -n "$NODE" ] && [ -x "$NODE" ] || muere "no encuentro el intérprete para leer el índice de servidores"
[ "$INSTALADO" = 1 ] && verificar_binario "$NODE" "/opt/tycon/bin/node" "el intérprete"
[ -f "$INDICE_JS" ] || muere "no encuentro el índice de servidores ($INDICE_JS)"

# ── la sentencia: lo que engañaría en el cuadro ──────────────────────────────────────────────────
# La misma lista que el freno, mirada por el intérprete ya verificado y no por grep: grep depende de la configuración
# regional, y con LC_ALL=C no reconoce un carácter de varios bytes. Si la revisión no se puede hacer, no se conecta.
if [ "$MODO" = consulta ] || [ "$MODO" = azure ]; then
  motivo="$(printf '%s' "$SENTENCIA" | "$NODE" -e '
    const fuera = (m) => { process.stdout.write(m); process.exit(2); };
    let t; try { t = new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(require("fs").readFileSync(0)); } catch (_) { fuera("no es texto UTF-8 válido"); }
    if (t.includes("\u{fffd}")) fuera("no es texto UTF-8 válido");
    if (/[\x00-\x08\x0b-\x1f\x7f-\x9f]/u.test(t)) fuera("tiene caracteres de control: en el cuadro se habría visto otra cosa que lo que corre");
    if (/[\u{ad}\u{34f}\u{61c}\u{115f}\u{1160}\u{17b4}\u{17b5}\u{180b}-\u{180e}\u{200b}-\u{200f}\u{202a}-\u{202e}\u{2028}\u{2029}\u{2060}-\u{206f}\u{2800}\u{3164}\u{fe00}-\u{fe0f}\u{feff}\u{ffa0}\u{fff9}-\u{fffc}\u{e0000}-\u{e007f}\u{e0100}-\u{e01ef}]/u.test(t)) fuera("tiene caracteres invisibles o de dirección: en el cuadro se habría leído otra cosa que lo que corre");
  ')" || muere "la sentencia ${motivo:-no se pudo revisar}: mandala sin esos caracteres"
  # lo que el cuadro no muestra entero no se manda a aprobar: cada renglón cuenta como los que ocupa al cortarse, con el
  # ancho que ocupa en pantalla (un tabulador llega al múltiplo de 8 y un carácter ancho vale 2), como cuenta el freno.
  # Una lectura de --azure no abre cuadro: no tiene tope.
  { [ "$MODO" = azure ] && [ "$AZ_LECTURA" = 1 ]; } || printf '%s' "$SENTENCIA" | "$NODE" -e '
    const t = require("fs").readFileSync(0, "utf8"); const [max, maxR, cols] = process.argv.slice(1).map(Number);
    const doble = /[\u{1100}-\u{10ffff}]|\p{Extended_Pictographic}/u;
    let renglones = 0;
    for (const l of t.split("\n")) {
      let filas = 1, col = 0;
      for (const c of l) {
        const ancho = c === "\t" ? 8 - (col % 8) : doble.test(c) ? 2 : 1;
        if (col + ancho > cols) { filas++; col = 0; }
        col += c === "\t" ? 8 - (col % 8) : ancho;
      }
      renglones += filas;
    }
    process.exit([...t].length > max || renglones > maxR ? 2 : 0);
  ' "$CUADRO_MAX_CARACTERES" "$CUADRO_MAX_RENGLONES" "$CUADRO_COLUMNAS" \
    || muere "la sentencia es demasiado larga para que el cuadro la muestre entera: partila (el cuadro muestra hasta $CUADRO_MAX_CARACTERES caracteres en $CUADRO_MAX_RENGLONES renglones de $CUADRO_COLUMNAS)."
fi

if [ "$MODO" = reclasificar ]; then
  aprobar "Bajar $HOST a no producción en esta máquina: el freno deja de frenarlo y la puerta deja de atenderlo." reclasificar
  "$NODE" -e '
    const m = require(process.argv[1]);
    const host = m.normalizar(process.argv[2]);
    if (!host) { console.error("host inválido"); process.exit(2); }
    const i = m.construir({ home: process.env.HOME });
    i.memoria = (i.memoria || []).filter((h) => h !== host);
    if (i.hosts[host]) delete i.hosts[host];
    i.memoria_alterada = false;
    m.guardar(i, process.env.HOME, { resellar: true });
    console.log(`«${host}» ya no se trata como producción en esta máquina.`);
    console.log("Si algún proyecto lo sigue declarando así en su .tycon/production.json, volverá a frenarse.");
  ' "$INDICE_JS" "$HOST" || muere "no pude reclasificar «${HOST}»"
  anotar "\"host\":\"$HOST\",\"accion\":\"reclasificar\"$APROBACION,\"exit\":0"
  exit 0
fi

if [ "$MODO" = verificar ]; then
  MAL=0
  echo "freno instalado: $([ "$INSTALADO" = 1 ] && echo sí || echo no)"
  [ "$INSTALADO" = 1 ] || MAL=1
  echo "llavero propio: $LLAVERO_PROPIO"
  if [ -f "$LLAVERO_PROPIO" ]; then
    if salida="$("$SECURITY" dump-keychain -a "$LLAVERO_PROPIO" 2>&1)"; then
      echo "quién puede leer cada clave guardada:"
      servicios="$(servicios_del_llavero "$salida")"
      if [ -z "$servicios" ]; then echo "   (ninguna clave guardada todavía)"; fi
      for svc in $servicios; do
        problemas="$(quien_lee "$salida" "$svc")"
        if [ -z "$problemas" ]; then
          echo "   · $svc: sólo la herramienta del sistema ✓"
        else
          MAL=1
          if printf '%s' "$problemas" | grep -q CUALQUIERA; then
            echo "   · $svc: 🔴 CUALQUIER programa puede leerla sin cuadro (se cargó con «-A»). Borrala y volvé a cargarla."
          fi
          printf '%s\n' "$problemas" | sed -n 's/^AJENA /   · '"$svc"': 🔴 también confía en /p'
        fi
      done
    else
      MAL=1
      echo "   🔴 no pude leer la lista de confianza (¿llavero bloqueado?): $(printf '%s' "$salida" | head -1)"
    fi
  else
    echo "   (todavía no existe: se crea al cargar la primera clave)"
  fi
  if [ -x "$CLIENTE" ]; then echo "cliente de base: $CLIENTE ($(huella_de "$CLIENTE"))"; else echo "cliente de base: 🔴 NO está en $CLIENTE"; MAL=1; fi
  # la config de go-sqlcmd del usuario: si existe, el cliente preferiría la clave guardada AHÍ a la del
  # Llavero (ver la nota en la invocación del cliente). La puerta la ignora; acá se dice que existe.
  if [ -f "$HOME/.sqlcmd/sqlconfig" ]; then
    echo "config de go-sqlcmd del usuario (~/.sqlcmd/sqlconfig): existe — la puerta la IGNORA ✓ (si no, el cliente mandaría la clave guardada ahí y no la del Llavero)"
  fi
  # 🔴 Los hosts que la memoria recuerda como producción y que HOY no declara ningún catálogo: el
  # repo se borró, se renombró o su .tycon/production.json quedó ilegible. Siguen frenados (bien),
  # pero nadie los ve, y la puerta los atiende sin que ningún catálogo diga en qué llavero está su
  # clave (revisores del Step 5, 2026-09-15).
  "$NODE" -e '
    const m = require(process.argv[1]);
    const i = m.leer({ home: process.env.HOME });
    const sueltos = Object.entries(i.hosts || {}).filter(([, h]) => h.ambiente === "produccion" && !(h.repos || []).length);
    if (sueltos.length) {
      console.log("hosts de producción que YA no declara ningún proyecto (se recuerdan de antes):");
      for (const [h] of sueltos) console.log(`   · ${h}`);
      process.exitCode = 7;
    }
    if ((i.errores || []).length) {
      console.log("catálogos ILEGIBLES (sus hosts quedan desconocidos):");
      for (const e of i.errores) console.log(`   · ${e.repo}: ${e.motivo}`);
      process.exitCode = 7;
    }
  ' "$INDICE_JS" || MAL=1
  # La memoria tocada sólo en lo de antes del renombre (la memoria o el índice con su nombre viejo): lo legible se suma a
  # la nueva, se sella y lo viejo se borra. Sumar nunca baja un servidor. Con la memoria nueva tocada no se sella nada:
  # eso lo decide una persona con --reclassify, y acá no se sella por ningún otro camino.
  if memoria="$("$NODE" -e '
    const r = require(process.argv[1]).resolverViejos({ home: process.env.HOME });
    if (r.sellado && r.resuelto) console.log("memoria de producción: lo de antes del renombre pasó a la nueva y se borró ✓");
    else if (r.resuelto) console.log("memoria de producción: sana.");
    if (!r.resuelto) { console.log(`memoria de producción: 🔴 ${r.motivo}`); process.exitCode = 7; }
  ' "$INDICE_JS")"; then
    echo "$memoria"
    case "$memoria" in *"se borró"*) anotar "\"accion\":\"verify-memory\",\"exit\":0" ;; esac
  else
    echo "${memoria:-memoria de producción: 🔴 no pude revisarla}"; MAL=1
  fi
  # 🔴 Sale ≠ 0 cuando algo está mal. Salir siempre 0 hacía que «lo revisé y está todo bien» y
  # «lo revisé y está roto» fueran el mismo veredicto para quien lo llama desde un script
  # (revisores del Step 5, 2026-09-15).
  [ "$MAL" = 0 ] || exit 1
  exit 0
fi

# ── az, para el firewall y los candados ─────────────────────────────────────────────────────────────────────────
# El tope de cada llamada, fijo instalada: 25 s a mano. El cierre de fin de sesión (`--session`, que sólo pasa el hook)
# hace 3 o 4 llamadas y el hook tiene ~60 s de verdad (medido con `claude -p`; no los 120 de la configuración): 13 s
# cada una. Lo que no alcanza a cerrar lo cierra el barrido del próximo arranque. La variable sólo vale con la raíz de
# prueba. az se busca en rutas fijas, nunca en el PATH.
AZ_TOPE=25; [ -n "$SESION_CIERRE" ] && AZ_TOPE=13; [ -n "$RAIZ" ] && [ -n "${TYCON_PROD_AZ_TIMEOUT:-}" ] && AZ_TOPE="$TYCON_PROD_AZ_TIMEOUT"
AZ=""; for c in "$RAIZ/opt/homebrew/bin/az" "$RAIZ/usr/local/bin/az" "$RAIZ/usr/bin/az"; do [ -x "$c" ] && { AZ="$c"; break; }; done
SUBS_ACTIVAS="[?state=='Enabled' || state=='Warned' || state=='PastDue'].id"
# az con un entorno limpio (nada del Llavero ni de la base), con tope de tiempo; 142 = el tope lo cortó
correr_az(){ env -i HOME="$HOME" PATH=/usr/bin:/bin:/usr/sbin:/sbin LANG=C /usr/bin/perl -e 'alarm shift @ARGV; exec @ARGV or exit 127' "$AZ_TOPE" "$AZ" "$@"; }
# Deja SUB y RG del servidor CORTO. Ante una falla llama a $FALLA_AZ con el motivo y devuelve 1: el firewall sale ahí
# (fallo_fw); los candados anotan «no sé» y siguen con el próximo servidor. $TOPE_DICE completa el motivo del tope.
# Con `cero-vale`, un servidor que no aparece en ninguna suscripción devuelve 2 sin llamar a $FALLA_AZ, pero sólo si az
# pudo listar todas: una suscripción que no contestó puede ser justo la que lo tiene. Deja en SUB_LISTADA la primera
# suscripción con forma válida (vacía si no hubo ninguna): la consulta del nombre se hace contra una de la cuenta.
ubicar_servidor(){
  local subs salida rc s rg encontrados=0 fallidas=0; SUB=""; RG=""; SUB_LISTADA=""
  # las suscripciones activas: Enabled, y también Warned y PastDue, que siguen operando y tienen recursos
  subs="$(correr_az account list --query "$SUBS_ACTIVAS" -o tsv 2>"$_ESTADO/.az-err-$$")"; rc=$?
  salida="$(cat "$_ESTADO/.az-err-$$" 2>/dev/null)"; rm -f "$_ESTADO/.az-err-$$"
  [ "$rc" = 142 ] && { "$FALLA_AZ" "az no contestó en ${AZ_TOPE} s (tope): ${TOPE_DICE}. Reintentá."; return 1; }
  [ "$rc" = 0 ] || { "$FALLA_AZ" "az no pudo listar las suscripciones (código $rc): $(printf '%s' "$salida" | head -1). Si no iniciaste sesión: az login"; return 1; }
  for s in $subs; do
    printf '%s' "$s" | grep -qE '^[A-Za-z0-9-]+$' || continue
    [ -n "$SUB_LISTADA" ] || SUB_LISTADA="$s"
    rg="$(correr_az sql server list --subscription "$s" --query "[?name=='$CORTO'].resourceGroup" -o tsv 2>/dev/null)"; rc=$?
    [ "$rc" = 142 ] && { "$FALLA_AZ" "az no contestó en ${AZ_TOPE} s (tope) al buscar el servidor. Reintentá."; return 1; }
    [ "$rc" = 0 ] || fallidas=$((fallidas+1))
    for g in $rg; do encontrados=$((encontrados+1)); SUB="$s"; RG="$g"; done
  done
  if [ "$encontrados" = 0 ] && [ "${1:-}" = cero-vale ]; then
    [ "$fallidas" = 0 ] && return 2
    "$FALLA_AZ" "el servidor «${CORTO}» no aparece, pero az no pudo listar $fallidas suscripción(es): no sé si sigue existiendo."; return 1
  fi
  [ "$encontrados" = 1 ] || { "$FALLA_AZ" "el servidor «${CORTO}» aparece en $encontrados lugar(es) entre tus suscripciones: necesito exactamente uno, no elijo a ciegas."; return 1; }
  printf '%s' "$RG" | grep -qE '^[A-Za-z0-9._()-]+$' || { "$FALLA_AZ" "el grupo de recursos que devolvió az («${RG}») no tiene forma de nombre."; return 1; }
}

# ── Azure: el cambio de administración, con cuadro; la lectura, sin él ───────────────────────────────────────────
# az corre con el entorno limpio de `correr_az`: nunca ve la clave de la base ni nada del Llavero. Cada argumento llega en
# su lugar, sin pasar por un shell.
if [ "$MODO" = azure ]; then
  [ -n "$AZ" ] || muere "no encuentro az en sus rutas fijas (/opt/homebrew/bin, /usr/local/bin, /usr/bin): la puerta no usa el del PATH."
  if [ "$AZ_LECTURA" = 1 ]; then
    APROBACION=',"aprobacion":"lectura-sin-cuadro"'; ACCION=azure-lectura
  else
    aprobar "Cambio de administración en Azure (producción):

$SENTENCIA" azure
    ACCION=azure
  fi
  SALIDA="$(correr_az "${AZ_ARGS[@]}" 2>&1)"; RC=$?
  printf '%s\n' "$SALIDA"
  [ "$RC" = 142 ] && printf 'az no contestó en %s s (tope): no sé si el cambio quedó. Miralo con la lectura (list o show) antes de repetirlo.\n' "$AZ_TOPE"
  printf 'rc=%s\n' "$RC"
  anotar "\"accion\":\"$ACCION\",\"operacion\":\"$AZ_OP\",\"sha256\":\"$(printf '%s' "$SENTENCIA" | shasum -a 256 | cut -d' ' -f1)\"$APROBACION,\"exit\":$RC"
  exit "$RC"
fi

# ── los candados: qué servidores de producción declarados tienen el candado de Azure ───────────────────────────
# Sólo lee: `account list`, `sql server list` y `lock list`. Cuenta un candado CanNotDelete o ReadOnly sobre el servidor
# o sobre su grupo; uno de suscripción no se ve desde el grupo. A un servidor sin candado le imprime el comando para que
# lo corra una persona con permiso de locks: la puerta nunca crea ni quita un candado.
if [ "$MODO" = locks ]; then
  LISTA="$("$NODE" -e '
    const m = require(process.argv[1]); let i;
    try { i = m.leer({ home: process.env.HOME }); } catch (e) { process.stdout.write("ilegible|" + e.message); process.exit(0); }
    const prod = Object.keys(i.hosts || {}).filter((h) => i.hosts[h].ambiente === "produccion").sort();
    // un catálogo roto no deja ciegos a los demás: sus servidores se revisan y el roto se nombra como «no sé»
    if (i.memoria_alterada) { process.stdout.write("ilegible|la memoria de producción fue tocada a mano (su huella no cierra)"); process.exit(0); }
    const rotos = (i.errores || []).map((e) => `${String(e.repo).replace(/[^\w./-]/g, "?")}: ${String(e.motivo).replace(/[\r\n|]/g, " ")}`);
    process.stdout.write("ok|" + prod.join(" ") + "|" + rotos.join("\t"));
  ' "$INDICE_JS" 2>/dev/null)" || LISTA="ilegible|el intérprete falló"
  case "$LISTA" in
    ilegible\|*) anotar "\"accion\":\"candados\",\"exit\":2"; muere "no pude leer el índice de servidores (${LISTA#ilegible|}): no digo qué tiene candado sin saber qué es producción." ;;
  esac
  LISTA="${LISTA#ok|}"; PROD_HOSTS="${LISTA%%|*}"; ROTOS="${LISTA#*|}"
  if [ -z "$PROD_HOSTS" ] && [ -z "$ROTOS" ]; then
    echo "no hay servidores de producción declarados en esta máquina."
    anotar "\"accion\":\"candados\",\"servidores\":0,\"exit\":0"; exit 0
  fi
  NO_SE=0; CON=0; SIN=0
  FALLA_AZ=no_se_candado; TOPE_DICE="no sé si tiene candado"
  no_se_candado(){ echo "$H: no sé — $1"; NO_SE=$((NO_SE+1)); }
  for H in $PROD_HOSTS; do
    case "$H" in
      *.database.windows.net) CORTO="${H%.database.windows.net}" ;;
      *) echo "$H: no se maneja desde acá (no es un Azure SQL: el candado lo pone su administrador)"; continue ;;
    esac
    [[ "$CORTO" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { no_se_candado "el nombre corto no tiene forma de nombre de Azure SQL"; continue; }
    [ -n "$AZ" ] || { no_se_candado "no encuentro az en las rutas fijas (/opt/homebrew/bin, /usr/local/bin, /usr/bin). NO uso el del PATH."; continue; }
    ubicar_servidor || continue
    LOCKS="$(correr_az lock list --subscription "$SUB" -g "$RG" -o json 2>"$_ESTADO/.az-err-$$")"; rc=$?
    salida="$(cat "$_ESTADO/.az-err-$$" 2>/dev/null)"; rm -f "$_ESTADO/.az-err-$$"
    [ "$rc" = 142 ] && { no_se_candado "az no contestó en ${AZ_TOPE} s (tope) al leer los candados."; continue; }
    [ "$rc" = 0 ] || { no_se_candado "az no pudo leer los candados (código $rc): $(printf '%s' "$salida" | head -1)"; continue; }
    VEREDICTO="$(printf '%s' "$LOCKS" | "$NODE" -e '
      let t = ""; process.stdin.on("data", (d) => { t += d; }); process.stdin.on("end", () => {
        const [rg, srv] = process.argv.slice(1);
        let l; try { l = JSON.parse(t); if (!Array.isArray(l)) throw new Error("no es una lista"); } catch (e) { process.stdout.write("ilegible|" + e.message); return; }
        const base = `/resourcegroups/${rg.toLowerCase()}/providers/microsoft.authorization/locks/`;
        const delServidor = `/resourcegroups/${rg.toLowerCase()}/providers/microsoft.sql/servers/${srv.toLowerCase()}/providers/microsoft.authorization/locks/`;
        const sirve = l.find((x) => x && /^(CanNotDelete|ReadOnly)$/i.test(String(x.level || "")) && (String(x.id || "").toLowerCase().includes(base) || String(x.id || "").toLowerCase().includes(delServidor)));
        if (!sirve) { process.stdout.write("sin|"); return; }
        const donde = String(sirve.id).toLowerCase().includes(delServidor) ? "en el servidor" : "en el grupo";
        process.stdout.write(`con|${String(sirve.name || "?").replace(/[^\w.-]/g, "?")} (${sirve.level}, ${donde})`);
      });
    ' "$RG" "$CORTO" 2>/dev/null)" || VEREDICTO="ilegible|el intérprete falló"
    case "$VEREDICTO" in
      con\|*) echo "$H: con candado — ${VEREDICTO#con|}"; CON=$((CON+1)) ;;
      sin\|*) echo "$H: sin candado — lo corre una persona con permiso de locks, fuera del asistente:"
              # el grupo entre comillas: puede traer paréntesis, y el comando se pega en una terminal
              echo "  az lock create --name tycon-no-borrar --lock-type CanNotDelete --resource-group '$RG' --resource-name $CORTO --resource-type Microsoft.Sql/servers --subscription $SUB"
              SIN=$((SIN+1)) ;;
      *) no_se_candado "la respuesta de az no se pudo leer (${VEREDICTO#ilegible|})" ;;
    esac
  done
  # los catálogos que no se pudieron leer: sus servidores pueden ser de producción y no se miraron
  if [ -n "$ROTOS" ]; then
    while IFS= read -r roto; do
      [ -n "$roto" ] || continue
      echo "${roto%%: *}: no sé — su catálogo no se pudo leer (${roto#*: }): sus servidores no se revisaron"; NO_SE=$((NO_SE+1))
    done <<EOF
$(printf '%s' "$ROTOS" | tr '\t' '\n')
EOF
  fi
  RC=0; [ "$NO_SE" = 0 ] || RC=2
  anotar "\"accion\":\"candados\",\"con\":$CON,\"sin\":$SIN,\"no_se\":$NO_SE,\"exit\":$RC"
  exit "$RC"
fi

# ── borrar un grupo de recursos que no es de producción ─────────────────────────────────────────────────────────
# El freno corta todo `az group delete` directo: no puede saber qué contiene un grupo. La puerta sí le pregunta a Azure, y
# borra sólo si puede probar que el grupo es seguro: está en exactamente una suscripción, todos sus servidores SQL están
# declarados no-producción, no tiene una base de un tipo que el catálogo no cubre, y el listado de recursos coincide con
# el de servidores. Ante cualquier duda, sale 2 sin borrar. El borrado sale con `--no-wait`: la puerta dice que Azure
# aceptó el pedido (no que el grupo ya no está) y cómo confirmarlo.
if [ "$MODO" = delete-group ]; then
  SESION="${CLAUDE_CODE_SESSION_ID:-}"; [[ "$SESION" =~ $SESION_VALIDA ]] || SESION=""
  SERVIDORES_N=0
  fallo_grupo(){ # $1 = motivo · anota el intento y sale 2
    anotar "\"accion\":\"borrar-grupo\",\"grupo\":\"$GRUPO_B\",\"servidores\":$SERVIDORES_N,\"sesion\":\"$SESION\",\"exit\":2"
    muere "$1"
  }
  # el índice primero: sin saber qué es producción no se le pregunta nada a Azure
  INDICE_OK="$("$NODE" -e '
    const m = require(process.argv[1]); let i;
    try { i = m.leer({ home: process.env.HOME }); } catch (e) { process.stdout.write("ilegible: " + e.message); process.exit(0); }
    if ((i.errores || []).length) { process.stdout.write("ilegible: " + i.errores.map((e) => `${e.repo}: ${e.motivo}`).join(" · ")); process.exit(0); }
    // la memoria de producción tocada a mano: el freno no decide sobre ninguna base, y la puerta tampoco borra
    if (i.memoria_alterada) { process.stdout.write("ilegible: la memoria de producción fue tocada a mano (su huella no cierra)"); process.exit(0); }
    process.stdout.write("ok");
  ' "$INDICE_JS" 2>/dev/null)" || INDICE_OK="ilegible: el intérprete falló"
  [ "$INDICE_OK" = ok ] || fallo_grupo "no pude leer el índice de servidores (${INDICE_OK#ilegible: }): no borro un grupo sin saber qué es producción."
  [ -n "$AZ" ] || fallo_grupo "no encuentro az en las rutas fijas (/opt/homebrew/bin, /usr/local/bin, /usr/bin). NO uso el del PATH."

  # la suscripción: el grupo tiene que estar en exactamente una
  subs="$(correr_az account list --query "$SUBS_ACTIVAS" -o tsv 2>"$_ESTADO/.az-err-$$")"; rc=$?
  salida="$(cat "$_ESTADO/.az-err-$$" 2>/dev/null)"; rm -f "$_ESTADO/.az-err-$$"
  [ "$rc" = 142 ] && fallo_grupo "az no contestó en ${AZ_TOPE} s (tope) al listar las suscripciones. Reintentá."
  [ "$rc" = 0 ] || fallo_grupo "az no pudo listar las suscripciones (código $rc): $(printf '%s' "$salida" | head -1). Si no iniciaste sesión: az login"
  SUB=""; hallados=0
  for s in $subs; do
    printf '%s' "$s" | grep -qE '^[A-Za-z0-9-]+$' || continue
    nombre="$(correr_az group show -n "$GRUPO_B" --subscription "$s" --query name -o tsv 2>"$_ESTADO/.az-err-$$")"; rc=$?
    salida="$(cat "$_ESTADO/.az-err-$$" 2>/dev/null)"; rm -f "$_ESTADO/.az-err-$$"
    [ "$rc" = 142 ] && fallo_grupo "az no contestó en ${AZ_TOPE} s (tope) al buscar el grupo. Reintentá."
    if [ "$rc" = 0 ] && [ -n "$nombre" ]; then hallados=$((hallados+1)); SUB="$s"; continue; fi
    printf '%s' "$salida" | grep -q 'ResourceGroupNotFound' && continue
    fallo_grupo "az no pudo mirar el grupo en la suscripción $s (código $rc): $(printf '%s' "$salida" | head -1)"
  done
  [ "$hallados" = 1 ] || fallo_grupo "el grupo «${GRUPO_B}» aparece en $hallados suscripción(es): necesito exactamente una, no elijo a ciegas."

  # qué hay adentro: los servidores SQL y el tipo de cada recurso
  SERVS="$(correr_az sql server list --subscription "$SUB" -g "$GRUPO_B" --query "[].fullyQualifiedDomainName" -o tsv 2>"$_ESTADO/.az-err-$$")"; rc=$?
  salida="$(cat "$_ESTADO/.az-err-$$" 2>/dev/null)"; rm -f "$_ESTADO/.az-err-$$"
  [ "$rc" = 142 ] && fallo_grupo "az no contestó en ${AZ_TOPE} s (tope) al listar los servidores del grupo. No borro."
  [ "$rc" = 0 ] || fallo_grupo "az no pudo listar los servidores del grupo (código $rc): $(printf '%s' "$salida" | head -1). No borro sin saber qué hay."
  TIPOS="$(correr_az resource list --subscription "$SUB" -g "$GRUPO_B" --query "[].type" -o tsv 2>"$_ESTADO/.az-err-$$")"; rc=$?
  salida="$(cat "$_ESTADO/.az-err-$$" 2>/dev/null)"; rm -f "$_ESTADO/.az-err-$$"
  [ "$rc" = 142 ] && fallo_grupo "az no contestó en ${AZ_TOPE} s (tope) al listar los recursos del grupo. No borro."
  [ "$rc" = 0 ] || fallo_grupo "az no pudo listar los recursos del grupo (código $rc): $(printf '%s' "$salida" | head -1). No borro sin saber qué hay."

  RECURSOS_N=0; SQL_EN_RECURSOS=0
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    [[ "$t" =~ ^[A-Za-z0-9.]+/[A-Za-z0-9/]+$ ]] || fallo_grupo "el listado de recursos trae un tipo que no se puede leer («${t}»): no borro."
    RECURSOS_N=$((RECURSOS_N+1))
    case "$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')" in
      microsoft.sql/servers) SQL_EN_RECURSOS=$((SQL_EN_RECURSOS+1)) ;;
      microsoft.dbforpostgresql/*|microsoft.dbformysql/*|microsoft.dbformariadb/*|microsoft.sql/managedinstances|microsoft.sql/managedinstances/*|microsoft.sql/instancepools|microsoft.sql/instancepools/*|microsoft.sqlvirtualmachine/*|microsoft.documentdb/*|microsoft.synapse/workspaces|microsoft.synapse/workspaces/*)
        fallo_grupo "el grupo tiene una base de un tipo que el catálogo no cubre (${t}): no sé si es de producción. Lo borra una persona en su terminal, si corresponde." ;;
    esac
  done <<EOF
$TIPOS
EOF
  LISTA_S=""
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    [[ "$h" =~ $HOST_VALIDO ]] || fallo_grupo "el listado de servidores trae un nombre que no se puede leer («${h}»): no borro."
    SERVIDORES_N=$((SERVIDORES_N+1)); LISTA_S="$LISTA_S $h"
  done <<EOF
$SERVS
EOF
  # los dos listados tienen que contar los mismos servidores: si no, uno vino cortado
  [ "$SERVIDORES_N" = "$SQL_EN_RECURSOS" ] || fallo_grupo "los listados no coinciden ($SERVIDORES_N servidor(es) SQL contra $SQL_EN_RECURSOS en el listado de recursos): uno vino cortado. No borro."
  for h in $LISTA_S; do
    est="$("$NODE" -e 'const m = require(process.argv[1]); const i = m.leer({ home: process.env.HOME }); process.stdout.write(m.clasificar(process.argv[2], i).estado);' "$INDICE_JS" "$h" 2>/dev/null)" || est="ilegible"
    case "$est" in
      no-produccion) : ;;
      produccion) fallo_grupo "el grupo tiene «${h}», declarado como PRODUCCIÓN: no lo borro. Un grupo así lo borra una persona en su propia terminal, después de mirar qué contiene." ;;
      *) fallo_grupo "el grupo tiene «${h}», que no está declarado en ningún proyecto de esta máquina: no sé si es producción, así que no lo borro. Declaralo, o que lo borre una persona en su terminal." ;;
    esac
  done

  # 🔴 Probado que no tiene nada de producción, el borrado lo aprueba una persona en el cuadro de la puerta: no tiene vuelta
  # atrás, y es la única aprobación que tiene (la configuración administrada no pregunta por la puerta)
  # lo que no tiene vuelta atrás va primero, y la lista con tope: el cuadro no puede cortar justo la advertencia
  # shellcheck disable=SC2206 # los nombres ya pasaron su charset (HOST_VALIDO): sin espacios ni comodines
  _servs=($LISTA_S)
  LISTA_C=" ${_servs[*]:0:5}"; [ "${#_servs[@]}" -gt 5 ] && LISTA_C="$LISTA_C y $(( ${#_servs[@]} - 5 )) más"
  [ "${#_servs[@]}" -gt 0 ] || LISTA_C=""
  aprobar "No tiene vuelta atrás: borrar el grupo de recursos ${GRUPO_B} (suscripción ${SUB}), con ${RECURSOS_N} recurso(s) y ${SERVIDORES_N} servidor(es) SQL, ninguno declarado como producción${LISTA_C:+:${LISTA_C}}." borrar-grupo

  # el pedido de borrado
  salida="$(correr_az group delete -n "$GRUPO_B" --subscription "$SUB" --yes --no-wait 2>&1)"; rc=$?
  [ "$rc" = 142 ] && fallo_grupo "az no contestó en ${AZ_TOPE} s (tope) al pedir el borrado: no sé si el pedido salió. Mirá: az group exists -n $GRUPO_B --subscription $SUB"
  if [ "$rc" != 0 ]; then
    printf '%s' "$salida" | grep -q 'ScopeLocked' && fallo_grupo "Azure rechazó el borrado: el grupo (o algo adentro) tiene un candado. Sacarlo es de una persona con permiso de locks; si se acaba de sacar, esperá unos segundos y reintentá."
    fallo_grupo "az no pudo pedir el borrado (código $rc): $(printf '%s' "$salida" | head -1)"
  fi
  echo "Azure aceptó el pedido de borrar el grupo ${GRUPO_B} (suscripción ${SUB}). Eso no quiere decir que ya se borró."
  echo "Tenía ${SERVIDORES_N} servidor(es) SQL${LISTA_S:+:${LISTA_S}} y ${RECURSOS_N} recurso(s) en total."
  echo "Para confirmar que terminó: az group exists -n ${GRUPO_B} --subscription ${SUB}  (dice false cuando ya no está; si a los minutos sigue en true, el borrado falló: az group show lo dice)"
  anotar "\"accion\":\"borrar-grupo\",\"grupo\":\"$GRUPO_B\",\"servidores\":$SERVIDORES_N,\"sesion\":\"$SESION\",\"exit\":0"
  exit 0
fi

# ── el host tiene que ser producción (para lo demás no hace falta la puerta) ──────────────────
EST="$("$NODE" -e '
  const m = require(process.argv[1]);
  let i;
  try { i = m.leer({ home: process.env.HOME }); } catch (e) { process.stdout.write("ilegible|" + e.message); process.exit(0); }
  const c = m.clasificar(process.argv[2], i);
  process.stdout.write(`${c.estado}|${c.llavero || ""}|${c.base || ""}|${c.puerto || ""}`);
' "$INDICE_JS" "$HOST" 2>/dev/null)" || EST="ilegible|el intérprete falló|"
ESTADO="${EST%%|*}"; RESTO="${EST#*|}"; LLAVERO="${RESTO%%|*}"; RESTO="${RESTO#*|}"; BASE="${RESTO%%|*}"; PUERTO="${RESTO#*|}"

# ── el firewall: abrir y cerrar la regla de esta máquina ─────────────────────────────────────────
if [ "$MODO" = open-firewall ] || [ "$MODO" = close-firewall ]; then
  FIREWALL="$_ESTADO/production-firewall.json"
  SESION="${CLAUDE_CODE_SESSION_ID:-}"; [[ "$SESION" =~ $SESION_VALIDA ]] || SESION=""
  [ -n "$SESION_CIERRE" ] && SESION="$SESION_CIERRE"
  [ -n "$SESION_ABRE" ] && SESION="$SESION_ABRE"
  # el host como lo escribe el índice (minúsculas, sin punto final, el nombre corto con su dominio): el mismo servidor
  # escrito de otra forma es la misma regla y la misma entrada del estado
  HOST="$("$NODE" -e 'const m = require(process.argv[1]); process.stdout.write(m.normalizar(process.argv[2]) || "")' "$INDICE_JS" "$HOST" 2>/dev/null)"
  [[ "$HOST" =~ $HOST_VALIDO ]] || muere "el host no tiene forma de nombre de host."

  # El estado de las reglas abiertas: host, regla, IP, suscripción del servidor, desde cuándo, qué sesiones la usan y
  # una versión (`rev`) que sube con cada apertura. Lo escriben sólo la puerta y su hook, de a uno (un candado): dos puertas a la vez se
  # pisaban la lista de sesiones. Ilegible es «no sé» (sale 3) y no se pisa.
  estado_fw(){ # $1 = operación, resto = argumentos
    TYCON_FW_LOG="$REGISTRO" "$NODE" -e '
      const fs = require("fs"), path = require("path");
      const [archivo, op, host, a, b, c, d, g] = process.argv.slice(1);
      const candado = `${archivo}.lock`;
      const dormir = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
      fs.mkdirSync(path.dirname(archivo), { recursive: true });
      for (let i = 0; ; i++) {
        try { fs.mkdirSync(candado); break; } catch (err) {
          if (err.code !== "EEXIST") throw err;
          // un candado de más de 30 s es de una puerta que murió con él tomado
          try { if (Date.now() - fs.statSync(candado).mtimeMs > 30000) { fs.rmdirSync(candado); continue; } } catch (_) { continue; }
          if (i > 200) { console.error(`el estado del firewall está tomado por otra puerta hace rato (${candado})`); process.exit(3); }
          dormir(100);
        }
      }
      process.on("exit", () => { try { fs.rmdirSync(candado); } catch (_) {} });
      let e = { reglas: [] };
      if (fs.existsSync(archivo)) {
        try { e = JSON.parse(fs.readFileSync(archivo, "utf8")); if (!Array.isArray(e.reglas)) throw new Error("sin reglas"); }
        catch (err) { console.error(`el estado del firewall (${archivo}) está ilegible: ${err.message}`); process.exit(3); }
      }
      const guardar = () => { const t = `${archivo}.tmp-${process.pid}`; fs.writeFileSync(t, JSON.stringify(e, null, 2) + "\n"); fs.renameSync(t, archivo); };
      // viva = su proceso sigue corriendo, por lo que Claude Code anota de cada sesión en ~/.claude/sessions/<pid>.json
      // (igual en macOS, Linux y Windows). Sin esa anotación, el respaldo: su transcripción tuvo actividad en los
      // últimos 3 minutos. La misma regla que el hook prod-firewall-close.js
      const viva = (id) => {
        const home = process.env.HOME;
        // la misma sesión puede tener más de una anotación (una vieja de antes de reanudarla): viva si alguno de sus procesos lo está
        let anotada = false;
        try {
          for (const f of fs.readdirSync(path.join(home, ".claude", "sessions"))) {
            if (!/^[0-9]+[.]json$/.test(f)) continue;
            let j; try { j = JSON.parse(fs.readFileSync(path.join(home, ".claude", "sessions", f), "utf8")); } catch (_) { continue; }
            if (!j || j.sessionId !== id || !Number.isInteger(j.pid) || j.pid <= 0) continue;
            anotada = true;
            try { process.kill(j.pid, 0); return true; } catch (err) { if (err.code === "EPERM") return true; }
          }
        } catch (_) { /* sin el registro de sesiones: el respaldo */ }
        if (anotada) return false;
        const raiz = path.join(home, ".claude", "projects"); let ds = []; try { ds = fs.readdirSync(raiz); } catch (_) { return false; }
        return ds.some((d) => { try { return Date.now() - fs.statSync(path.join(raiz, d, `${id}.jsonl`)).mtimeMs < 3 * 60 * 1000; } catch (_) { return false; } }); };
      // ¿el registro muestra una apertura de este host sin un cierre posterior?
      const abiertaEnElRegistro = () => { let abierta = false;
        try { for (const l of fs.readFileSync(process.env.TYCON_FW_LOG, "utf8").split("\n")) { let j; try { j = JSON.parse(l); } catch (_) { continue; }
          if (!j || j.host !== host) continue;
          if (j.accion === "open-firewall") abierta = true; else if (j.accion === "close-firewall" && j.exit === 0) abierta = false; } } catch (_) {}
        return abierta; };
      const r = e.reglas.find((x) => x.host === host);
      if (op === "has") process.exit(r || abiertaEnElRegistro() ? 0 : 1);
      if (op === "rev") { process.stdout.write(String(r ? r.rev || 0 : "")); process.exit(0); }
      if (op === "location") { // «suscripción|grupo» donde se abrió: los del estado o, sin estado, los de la última apertura del registro
        let l0 = r && r.sub && r.rg ? r : null;
        if (!l0) try { for (const l of fs.readFileSync(process.env.TYCON_FW_LOG, "utf8").split("\n")) { let j; try { j = JSON.parse(l); } catch (_) { continue; }
          if (j && j.host === host && j.accion === "open-firewall") l0 = j; } } catch (_) {}
        const ok = l0 && typeof l0.sub === "string" && typeof l0.rg === "string" && l0.sub && l0.rg;
        process.stdout.write(ok ? `${l0.sub}|${l0.rg}` : ""); process.exit(0);
      }
      if (op === "open") { // a = regla, b = ip, c = sesión, d = suscripción, g = grupo. Se escribe ANTES de pedirle la regla a Azure: un tope deja rastro
        // volver a abrirla con su cuadro cuenta de nuevo el tope de horas (lo aplica el hook de cierre)
        if (r) { r.regla = a; r.ip = b; if (d && g) { r.sub = d; r.rg = g; } r.rev = (r.rev || 0) + 1; r.abierta = new Date().toISOString(); if (c && !r.sesiones.includes(c)) r.sesiones.push(c); }
        else e.reglas.push({ host, regla: a, ip: b, sub: d || undefined, rg: g || undefined, abierta: new Date().toISOString(), sesiones: c ? [c] : [], rev: 1 });
        guardar();
      } else if (op === "use") { if (r && a && !r.sesiones.includes(a)) { r.sesiones.push(a); guardar(); } }
      else if (op === "release") { // saca la sesión; imprime «sesiones vivas que siguen|versión»
        if (!r) { process.stdout.write("0|"); process.exit(0); }
        r.sesiones = r.sesiones.filter((s) => s !== a); guardar();
        process.stdout.write(`${r.sesiones.filter(viva).length}|${r.rev || 0}`);
      } else if (op === "remove") { // a = la versión que se cerró: si alguien la volvió a abrir en el medio, la entrada queda
        if (r && a !== "" && a !== undefined && String(r.rev || 0) !== a) { process.stdout.write("reabierta"); process.exit(0); }
        e.reglas = e.reglas.filter((x) => x.host !== host); guardar();
      }
    ' "$FIREWALL" "$@"
  }
  ACCION="$MODO"; POR=""; [ -n "$SESION_CIERRE" ] && POR=',"por":"fin-de-sesion"'
  fallo_fw(){ # $1 = motivo · anota el intento y sale 2
    anotar "\"host\":\"$HOST\",\"accion\":\"$ACCION\",\"regla\":\"${REGLA:-}\",\"sesion\":\"$SESION\"$POR$APROBACION,\"exit\":2"
    muere "$1"
  }

  # Cerrar es la dirección segura: un host del estado se cierra aunque hoy esté reclasificado o sin declarar.
  EN_ESTADO=0; estado_fw has "$HOST" 2>/dev/null && EN_ESTADO=1
  if [ "$MODO" = open-firewall ] || [ "$EN_ESTADO" = 0 ]; then
    case "$ESTADO" in
      produccion) : ;;
      no-produccion) muere "«${HOST}» está declarado como NO producción: su firewall no pasa por la puerta." ;;
      ilegible) muere "no pude leer el índice de servidores (${LLAVERO}). No toco ningún firewall sin saber qué es producción." ;;
      *) muere "«${HOST}» no está declarado como producción en ningún proyecto de esta máquina (ni hay una regla abierta para él)." ;;
    esac
  fi
  case "$HOST" in
    *.database.windows.net) CORTO="${HOST%.database.windows.net}" ;;
    *) muere "«${HOST}» no es un Azure SQL (*.database.windows.net): la puerta sólo maneja el firewall de Azure SQL." ;;
  esac
  [[ "$CORTO" =~ ^[a-z0-9][a-z0-9-]*$ ]] || muere "el nombre corto del servidor («${CORTO}») no tiene forma de nombre de Azure SQL."
  # abrir lo aprueba una persona antes de hacer nada; cerrar es la dirección segura y no pide cuadro (también al terminar la sesión)
  [ "$MODO" = open-firewall ] && aprobar "Abrir el firewall de $HOST para esta máquina (se cierra solo cuando termina la sesión que lo pidió, o a las 8 h)." open-firewall

  # el nombre de la regla: fijo por máquina, sin el nombre del equipo ni de la persona
  UUID="$("$RAIZ/usr/sbin/ioreg" -rd1 -c IOPlatformExpertDevice 2>/dev/null | sed -n 's/.*"IOPlatformUUID" = "\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$UUID" ] || muere "no pude leer el identificador de esta máquina: sin él la regla no tendría un nombre propio."
  REGLA="tycon-gate-$(printf '%s' "$UUID" | shasum -a 256 | cut -c1-8)"

  [ -n "$AZ" ] || fallo_fw "no encuentro az en las rutas fijas (/opt/homebrew/bin, /usr/local/bin, /usr/bin). NO uso el del PATH. Instalalo con: brew install azure-cli"

  FALLA_AZ=fallo_fw; TOPE_DICE="no sé si el firewall cambió"   # ubicar_servidor (el bloque común) sale por acá
  regla_az(){ correr_az sql server firewall-rule "$1" --subscription "$SUB" -g "$RG" -s "$CORTO" -n "$REGLA" "${@:2}"; }

  if [ "$MODO" = close-firewall ]; then
    REV=""
    if [ -n "$SESION_CIERRE" ]; then
      soltado="$(estado_fw release "$HOST" "$SESION_CIERRE")" || soltado=""
      quedan="${soltado%%|*}"; REV="${soltado#*|}"
      if [ -n "$quedan" ] && [ "$quedan" != 0 ]; then
        printf 'la regla %s de %s sigue abierta: la usa(n) %s sesión(es) viva(s)\n' "$REGLA" "$CORTO" "$quedan"; exit 0
      fi
    else
      REV="$(estado_fw rev "$HOST" 2>/dev/null)" || REV=""
    fi
    # Un servidor borrado se lleva sus reglas. Eso se da por cerrado sólo con el lugar anotado al abrir (suscripción y
    # grupo): az pregunta por ese servidor puntual y tiene que contestar «no existe». Un listado vacío no alcanza: Azure
    # no muestra lo que la cuenta ya no puede ver, y un permiso vencido se leería como un servidor borrado. Si dice que
    # no existe, se busca en las demás suscripciones por si se movió. Sin lugar anotado (una regla abierta antes de
    # anotarlo), un servidor que no aparece en ninguna suscripción se da por cerrado sólo si Azure dice que su nombre
    # está libre: el nombre forma el punto de conexión público, así que no lo puede tener ningún servidor, tampoco uno
    # que la cuenta no ve. Cualquier otra respuesta es «no sé».
    LUGAR="$(estado_fw location "$HOST" 2>/dev/null)" || LUGAR=""
    SUB_ANOTADA="${LUGAR%%|*}"; RG_ANOTADO="${LUGAR#*|}"
    [[ "$SUB_ANOTADA" =~ ^[A-Za-z0-9-]+$ ]] && [[ "$RG_ANOTADO" =~ ^[A-Za-z0-9._()-]+$ ]] || { SUB_ANOTADA=""; RG_ANOTADO=""; }
    BORRADO=0; UBICADO=0
    if [ -n "$SUB_ANOTADA" ]; then
      salida="$(correr_az sql server show --subscription "$SUB_ANOTADA" -g "$RG_ANOTADO" -n "$CORTO" --query name -o tsv 2>&1)"; rc=$?
      [ "$rc" = 142 ] && fallo_fw "az no contestó en ${AZ_TOPE} s (tope): la regla queda anotada como abierta. Reintentá: /opt/tycon/bin/tycon-prod-sql --close-firewall $HOST"
      if [ "$rc" = 0 ]; then SUB="$SUB_ANOTADA"; RG="$RG_ANOTADO"; UBICADO=1
      elif printf '%s' "$salida" | grep -qE '\((ResourceNotFound|ResourceGroupNotFound)\)'; then
        ubicar_servidor cero-vale; rc=$?; [ "$rc" = 2 ] && BORRADO=1; [ "$rc" = 0 ] && UBICADO=1
      else
        fallo_fw "az no pudo mirar el servidor donde se abrió la regla (${SUB_ANOTADA}/${RG_ANOTADO}, código $rc): $(printf '%s' "$salida" | head -1). Queda anotada como abierta. Reintentá: /opt/tycon/bin/tycon-prod-sql --close-firewall $HOST"
      fi
    fi
    if [ "$BORRADO" = 1 ]; then
      echo "el servidor $CORTO ya no existe donde se abrió la regla (${SUB_ANOTADA}/${RG_ANOTADO}) y no lo encuentro en tus suscripciones: la doy por cerrada (la regla $REGLA se borra con el servidor)"
      estado_fw remove "$HOST" "$REV" >/dev/null || true
      anotar "\"host\":\"$HOST\",\"accion\":\"close-firewall\",\"regla\":\"$REGLA\",\"sesion\":\"$SESION\"$POR,\"servidor\":\"borrado\",\"exit\":0"
      exit 0
    fi
    if [ "$UBICADO" != 1 ]; then
      ubicar_servidor cero-vale; rc=$?
      if [ "$rc" = 2 ]; then
        NO_APARECE="el servidor «${CORTO}» aparece en 0 lugar(es) entre tus suscripciones"
        [ -n "$SUB_LISTADA" ] || fallo_fw "${NO_APARECE}, y tu cuenta no tiene ninguna suscripción válida donde mirarlo: no sé si sigue existiendo."
        # stdout y stderr aparte: una advertencia de az en stderr no puede cambiar la respuesta
        NOMBRE="$(correr_az rest --method post \
          --uri "https://management.azure.com/subscriptions/$SUB_LISTADA/providers/Microsoft.Sql/checkNameAvailability?api-version=2023-08-01" \
          --headers Content-Type=application/json \
          --body "{\"name\":\"$CORTO\",\"type\":\"Microsoft.Sql/servers\"}" \
          --query available -o json 2>"$_ESTADO/.az-err-$$")"; rc=$?
        salida="$(cat "$_ESTADO/.az-err-$$" 2>/dev/null)"; rm -f "$_ESTADO/.az-err-$$"
        [ "$rc" = 142 ] && fallo_fw "${NO_APARECE} y az no contestó en ${AZ_TOPE} s (tope) si su nombre está libre: no sé si sigue existiendo. Queda anotada como abierta."
        [ "$rc" = 0 ] || fallo_fw "${NO_APARECE} y az no pudo consultar si su nombre está libre (código $rc): $(printf '%s' "$salida" | head -1). No sé si sigue existiendo: queda anotada como abierta."
        [ "$NOMBRE" = false ] && fallo_fw "${NO_APARECE}, pero Azure dice que su nombre está en uso: el servidor existe en un lugar que tu cuenta no ve. Queda anotada como abierta."
        [ "$NOMBRE" = true ] || fallo_fw "${NO_APARECE} y la consulta del nombre trajo una respuesta que no entiendo: no sé si sigue existiendo. Queda anotada como abierta."
        # con la prueba: se saca del estado sólo si nadie la volvió a abrir mientras se preguntaba (sin entrada, una
        # que haya aparecido tampoco coincide), y el cierre se anota sólo si el estado se pudo escribir
        sacada="$(estado_fw remove "$HOST" "${REV:-sin-entrada}")" || fallo_fw "no pude sacar la regla del estado del firewall: no la doy por cerrada. Queda anotada como abierta."
        [ "$sacada" = reabierta ] && fallo_fw "la regla $REGLA se volvió a abrir mientras preguntaba si el servidor existe: no la doy por cerrada."
        echo "el servidor $CORTO ya no existe: no aparece en ninguna de tus suscripciones y Azure dice que su nombre está libre. Doy por cerrada la regla $REGLA (se borró con el servidor)"
        anotar "\"host\":\"$HOST\",\"accion\":\"close-firewall\",\"regla\":\"$REGLA\",\"sesion\":\"$SESION\"$POR,\"servidor\":\"borrado\",\"prueba\":\"nombre-libre\",\"exit\":0"
        exit 0
      fi
    fi
    salida="$(regla_az show 2>&1)"; rc=$?
    [ "$rc" = 142 ] && fallo_fw "az no contestó en ${AZ_TOPE} s (tope): la regla queda anotada como abierta. Reintentá: /opt/tycon/bin/tycon-prod-sql --close-firewall $HOST"
    if [ "$rc" = 0 ]; then
      salida="$(regla_az delete 2>&1)"; rc=$?
      [ "$rc" = 142 ] && fallo_fw "az no contestó en ${AZ_TOPE} s (tope): la regla queda anotada como abierta. Reintentá: /opt/tycon/bin/tycon-prod-sql --close-firewall $HOST"
      [ "$rc" = 0 ] || fallo_fw "az no pudo borrar la regla $REGLA (código $rc): $(printf '%s' "$salida" | head -1). Queda anotada como abierta."
      echo "regla $REGLA cerrada en $CORTO"
    elif printf '%s' "$salida" | grep -q 'ResourceNotFound'; then
      echo "la regla $REGLA ya no estaba en $CORTO"
    else
      # 🔴 Sólo «no existe» cuenta como cerrada. Un límite de pedidos, la red, un permiso o una sesión vencida NO
      # dicen nada de la regla: si se leyeran como «ya no estaba», una regla viva en producción quedaría sin rastro.
      fallo_fw "az no pudo mirar la regla $REGLA (código $rc): $(printf '%s' "$salida" | head -1). Queda anotada como abierta. Reintentá: /opt/tycon/bin/tycon-prod-sql --close-firewall $HOST"
    fi
    estado_fw remove "$HOST" "$REV" >/dev/null || true
    anotar "\"host\":\"$HOST\",\"accion\":\"close-firewall\",\"regla\":\"$REGLA\",\"sesion\":\"$SESION\"$POR,\"exit\":0"
    exit 0
  fi

  # abrir: la IP sale del rechazo del propio Azure SQL al intentar entrar, con un usuario que no existe y sin la clave
  # La clave del intento es el nombre del usuario de prueba, que no es ninguna clave: con la clave vacía sqlcmd la pide por teclado y,
  # sin teclado, falla antes de conectarse, así que Azure nunca llega a decir la IP. El rechazo 40615 llega antes de
  # que Azure mire la clave.
  verificar_binario "$CLIENTE" "/opt/tycon/bin/sqlcmd" "el cliente de base"
  SONDA=tycon-gate-probe
  PRUEBA="$(HOME=/var/empty SQLCMDPASSWORD="$SONDA" "$CLIENTE" -x -S "$HOST" -U "$SONDA" -Q 'select 1' -l 15 -b 2>&1)"
  IP="$(printf '%s' "$PRUEBA" | sed -n "s/.*Client with IP address '\([^']*\)' is not allowed.*/\1/p" | head -1)"
  if [ -z "$IP" ] && printf '%s' "$PRUEBA" | grep -qi 'Login failed'; then
    # la conexión llegó a la etapa de la clave: esta IP ya tiene acceso (por la regla de la puerta o por otra)
    estado_fw use "$HOST" "$SESION" || true
    echo "ya tenés acceso a $CORTO desde esta máquina: no hace falta abrir nada"
    exit 0
  fi
  ip_publica(){ # una IPv4 pública, una sola dirección, sin ceros adelante (`010.1.2.3` es otra forma de escribir una privada)
    [[ "$1" =~ ^((0|[1-9][0-9]{0,2})\.){3}(0|[1-9][0-9]{0,2})$ ]] || return 1
    local IFS=.; set -- $1
    for o in "$@"; do [ "$o" -le 255 ] || return 1; done
    case "$1" in 0|10|127) return 1 ;; esac
    [ "$1" = 172 ] && [ "$2" -ge 16 ] && [ "$2" -le 31 ] && return 1
    [ "$1" = 192 ] && [ "$2" = 168 ] && return 1
    [ "$1" = 169 ] && [ "$2" = 254 ] && return 1
    return 0
  }
  ip_publica "$IP" || fallo_fw "no pude saber la IP de esta máquina: el rechazo de Azure no trajo una IPv4 pública ($(printf '%s' "$PRUEBA" | head -1 | cut -c1-160)). No la adivino."
  ubicar_servidor
  regla_az show >/dev/null 2>&1; rc=$?
  [ "$rc" = 142 ] && fallo_fw "az no contestó en ${AZ_TOPE} s (tope): no sé si la regla existe. Reintentá."
  if [ "$rc" = 0 ]; then OP=update; else OP=create; fi
  # 🔴 Se anota ANTES de pedirla: si az llega al tope o falla después de crearla, la regla puede existir en Azure, y
  # el fin de sesión o el barrido la tienen que encontrar. Sin poder anotarla, no se abre.
  estado_fw open "$HOST" "$REGLA" "$IP" "$SESION" "$SUB" "$RG" || fallo_fw "no pude anotar la regla en el estado del firewall: no la abro sin poder cerrarla después."
  salida="$(regla_az "$OP" --start-ip-address "$IP" --end-ip-address "$IP" 2>&1)"; rc=$?
  [ "$rc" = 142 ] && fallo_fw "az no contestó en ${AZ_TOPE} s (tope): no sé si la regla quedó. Queda anotada: se cierra al terminar la sesión, o ya: /opt/tycon/bin/tycon-prod-sql --close-firewall $HOST"
  [ "$rc" = 0 ] || fallo_fw "az no pudo $([ "$OP" = create ] && echo crear || echo actualizar) la regla (código $rc): $(printf '%s' "$salida" | head -1). Queda anotada por si quedó a medias: se cierra al terminar la sesión."
  anotar "\"host\":\"$HOST\",\"accion\":\"open-firewall\",\"regla\":\"$REGLA\",\"ip\":\"$IP\",\"sub\":\"$SUB\",\"rg\":\"$RG\",\"sesion\":\"$SESION\"$APROBACION,\"exit\":0"
  if [ -n "$SESION" ]; then echo "regla $REGLA abierta para $IP en $CORTO — se cierra sola cuando termina la sesión $SESION, o a las 8 h"
  else echo "regla $REGLA abierta para $IP en $CORTO — sin una sesión a su nombre: se cierra en el próximo arranque de una sesión de esta máquina"; fi
  exit 0
fi

case "$ESTADO" in
  produccion) : ;;
  no-produccion) muere "«${HOST}» está declarado como NO producción: consultalo directo, la puerta es para producción." ;;
  ilegible) muere "no pude leer el índice de servidores (${LLAVERO}). No abro nada sin saber qué es producción." ;;
  *) muere "«${HOST}» no está declarado como producción en ningún proyecto de esta máquina. La puerta sólo abre bases declaradas." ;;
esac
[ -n "$LLAVERO" ] || muere "«${HOST}» está declarado como producción pero sin «keychain» en su .tycon/production.json"
printf '%s' "$LLAVERO" | grep -qE "$LLAVERO_VALIDO" || muere "la entrada del Llavero de «${HOST}» («${LLAVERO}») no empieza con tycon-prod-: no la leo."
# `base`: a qué base entra el cliente. En Azure SQL no hay `USE` ni nombres de tres partes: sin esto
# entra a `master` y toda tabla es «Invalid object name» (medido contra un servidor interno el 2026-09-15 — guides/maintaining/incident-log.md#case-azure-sql-enters-master-2026-09-15 —, con
# la clave ya bien). Es opcional (un servidor con una sola base de default no la necesita) y su charset
# es estricto porque va como argumento del cliente.
ARGS_BASE=()
if [ -n "$BASE" ]; then
  printf '%s' "$BASE" | grep -qE "$BASE_VALIDA" || muere "la «base» declarada para «${HOST}» («${BASE}») no tiene forma de nombre de base: no la uso."
  ARGS_BASE=(-d "$BASE")
fi

# ── el cliente de base: el de root, con su huella (y su dueño, instalada) ────────────────────
verificar_binario "$CLIENTE" "/opt/tycon/bin/sqlcmd" "el cliente de base"

# ── la entrada del Llavero ────────────────────────────────────────────────────────────────────
dejar_command(){
  [ -f "$PLANTILLA" ] || muere "falta la plantilla para cargar la clave ($PLANTILLA). Reinstalá el freno."
  mkdir -p "$HOME/Desktop" 2>/dev/null
  DESTINO="$HOME/Desktop/cargar-clave-$LLAVERO.command"
  # host y llavero ya pasaron su charset estricto: no pueden inyectar nada en el script
  sed -e "s|@LLAVERO@|$LLAVERO|g" -e "s|@HOST@|$HOST|g" -e "s|@LLAVERO_PROPIO@|$LLAVERO_PROPIO|g" "$PLANTILLA" > "$DESTINO" \
    && chmod 700 "$DESTINO" || muere "no pude dejar el archivo para cargar la clave en $DESTINO"
  anotar "\"host\":\"$HOST\",\"accion\":\"falta-clave\",\"exit\":3"
  muere "falta la contraseña de «${HOST}» en el Llavero.
   Te dejé en el Escritorio: cargar-clave-$LLAVERO.command — abrilo con doble clic y cargá usuario y clave.
   No pasan por la conversación, y el archivo se borra solo al terminar." 3
}

# `--load-key <host>`: deja el archivo y lo abre, sin consultar nada. El host ya se validó arriba
# (tiene que estar declarado como producción y traer su «llavero»), así que acá sólo queda escribirlo.
if [ "$MODO" = cargar-clave ]; then
  [ -f "$PLANTILLA" ] || muere "falta la plantilla para cargar la clave ($PLANTILLA). Reinstalá el freno."
  mkdir -p "$HOME/Desktop" 2>/dev/null
  DESTINO="$HOME/Desktop/cargar-clave-$LLAVERO.command"
  sed -e "s|@LLAVERO@|$LLAVERO|g" -e "s|@HOST@|$HOST|g" -e "s|@LLAVERO_PROPIO@|$LLAVERO_PROPIO|g" "$PLANTILLA" > "$DESTINO" \
    && chmod 700 "$DESTINO" || muere "no pude dejar el archivo para cargar la clave en $DESTINO"
  anotar "\"host\":\"$HOST\",\"accion\":\"cargar-clave\",\"exit\":0"
  printf 'Te dejé en el Escritorio: cargar-clave-%s.command\n' "$LLAVERO"
  printf '   Abrilo con doble clic y cargá usuario y contraseña. No pasan por la conversación,\n   y el archivo se borra solo al terminar.\n'
  # se abre solo en la máquina de verdad; bajo la raíz de prueba no (abriría una Terminal en medio de la suite)
  [ -n "$RAIZ" ] || open "$HOME/Desktop/cargar-clave-$LLAVERO.command" 2>/dev/null || true
  exit 0
fi

[ -f "$LLAVERO_PROPIO" ] || [ -n "$RAIZ" ] || dejar_command

# 🔴 La persona aprueba ANTES de cualquier llamada a `security`: rechazado, la clave no se lee ni se mira su entrada.
# Pedida por una sesión, con el click en la sesión y sin el cuadro del sistema; desde una terminal, con el cuadro del sistema.
if en_una_sesion; then aprobar_en_la_sesion; else aprobar "Servidor: $HOST

Sentencia:
$SENTENCIA" consulta; fi

# (AC 21) la entrada tiene que confiar SÓLO en la herramienta del sistema. Si no se puede mirar, NO se
# lee: «no pude verificar» no es «está bien» (revisores del Step 5, 2026-09-15).
if ! confianzas="$("$SECURITY" dump-keychain -a "$LLAVERO_PROPIO" 2>/dev/null)"; then
  muere "no pude verificar en quién confía la entrada del Llavero (¿llavero bloqueado?). No leo la clave sin verificarlo."
fi
problemas="$(quien_lee "$confianzas" "$LLAVERO")"
if printf '%s' "$problemas" | grep -q CUALQUIERA; then
  muere "la contraseña de «${HOST}» la puede leer CUALQUIER programa, sin cuadro (la entrada se cargó
   con «-A»). No la uso así: borrala desde Acceso a Llaveros y volvé a consultar — te dejo el
   .command para cargarla de nuevo, que la carga bien."
fi
ajenas="$(printf '%s\n' "$problemas" | sed -n 's/^AJENA //p')"
if [ -n "$ajenas" ]; then
  muere "la entrada del Llavero confía en algo más que la herramienta del sistema:
$(printf '%s\n' "$ajenas" | sed 's/^/     /')
   Cualquiera de esos procesos podría sacar la contraseña sin cuadro. Borrá la entrada desde Acceso a
   Llaveros y volvé a consultar: te voy a dejar el .command para cargarla de nuevo."
fi

# el llavero va como argumento posicional al final (así lo pide `security`; no existe `-k` en find)
atributos="$("$SECURITY" find-generic-password -s "$LLAVERO" "$LLAVERO_PROPIO" 2>&1)"; rc_attr=$?
case "$rc_attr" in
  0) : ;;
  44) dejar_command ;;
  *) muere "no pude leer la entrada «${LLAVERO}» del Llavero (código $rc_attr, ¿llavero bloqueado?)." ;;
esac
USUARIO="$(printf '%s' "$atributos" | sed -n 's/.*"acct"<blob>="\([^"]*\)".*/\1/p' | head -1)"
[ -n "$USUARIO" ] || muere "la entrada «${LLAVERO}» del Llavero no tiene usuario. Borrala y volvé a cargarla con el .command."
# 🔴 Acá la entrada EXISTE (sus atributos se leyeron recién): si la contraseña no sale, es que el
# llavero está bloqueado o el permiso cambió — NO que falte. Salía 3, el mismo código que «falta la
# clave, cargala», y el que llama mandaba a cargar de nuevo una clave que ya está (Step 5).
CLAVE="$("$SECURITY" find-generic-password -s "$LLAVERO" -w "$LLAVERO_PROPIO" 2>/dev/null)" || CLAVE=""
[ -n "$CLAVE" ] || muere "la entrada «${LLAVERO}» está en el Llavero pero no pude leer su contraseña
   (¿el llavero quedó bloqueado, o le cambiaron el permiso?). Revisalo con: tycon-prod-sql --verify"

# ── la consulta ───────────────────────────────────────────────────────────────────────────────
# -x: sin sustitución de variables — una sentencia con `$(SQLCMDPASSWORD)` devolvería la clave.
# 🔴 NO va `-X1`, y no es un descuido: `-X[1]` es la forma del sqlcmd VIEJO (el de ODBC). El cliente
# que copia el instalador es go-sqlcmd (1.8.2 acá), y contra él ese flag rompe de dos maneras, las
# dos medidas el 2026-09-16 con el cliente real:
#   · `-X1` y `-X=1` ni siquiera parsean → «Sqlcmd: '0': Unknown command», o sea que la puerta NO
#     corría ninguna consulta: fallaba con cualquier sentencia, incluso `select 1`.
#   · `-X 1`, `-X` y `--disable-cmd-and-warn=1` sí parsean, pero entonces el cliente IGNORA el `-Q`
#     y se va a modo interactivo («liner: function not supported in this terminal»).
# O sea que no hay forma de ese flag que sirva. Lo que daba —frenar los comandos del cliente— lo
# hace ahora la validación de la sentencia, más arriba, que además corta antes de conectarse.
#
# 🔴 HOME=/var/empty, y no es cosmético: go-sqlcmd lee `~/.sqlcmd/sqlconfig`, y si ahí hay un
# contexto actual con usuario guardado, MANDA AL SERVIDOR LA CLAVE GUARDADA AHÍ e ignora
# SQLCMDPASSWORD, aunque se le pasen `-S` y `-U` explícitos. Medido el 2026-09-15 con un servidor TDS
# de mentira que decodifica el LOGIN7 (scripts/tests/lib/tds-spy.py): con el archivo presente el
# cliente mandó una clave vieja de marzo (con un `\` de más), sin el archivo mandó la de la variable.
# El dev cargó la clave del Llavero TRES veces creyendo que se equivocaba: la puerta nunca la mandó.
# Con HOME en una carpeta vacía el cliente no ve ninguna config del usuario (y no escribe nada:
# verificado). `-P` también la mandaría bien, pero va por los argumentos y `ps` la mostraría.
# ── a dónde se conecta: host, y el puerto sólo si el catálogo lo declara ──────────────────────
# 🔴 Se llama SERVIDOR y no DESTINO a propósito: `DESTINO` ya se usa más arriba para la RUTA del
# archivo que se deja en el Escritorio para cargar la clave. Hoy no chocan —esos caminos salen
# antes de llegar acá— pero dos cosas distintas con el mismo nombre en el freno de producción es
# el tipo de coincidencia que un día deja de serlo.
# `puerto` entró el 2026-09-29 con el primer servidor de INSTANCIA NOMBRADA en puerto no estándar
# (SQL Server escuchando en 1435, no en 1433). El cliente entiende `host,puerto` para eso; el
# nombre de instancia con barra invertida NO hace falta, y sigue rechazado.
#
# 🔴 La persona NUNCA tipea la coma: el host que valida `HOST_VALIDO`, el que busca el catálogo y
# el que el freno reconoce cuando aparece en un comando sigue siendo el nombre pelado. La coma la
# pega la puerta, acá, con un valor que viene del catálogo. Por eso esto NO aflojó ninguna
# validación: es lo contrario de admitir la coma en el argumento.
#
# Se vuelve a validar aunque el lint del catálogo ya lo valide: ese lint corre al commitear, y este
# valor llega de un archivo del disco que pudo editarse después. Sin esto, cualquier cosa metida en
# `puerto` viajaría pegada al argumento del cliente.
SERVIDOR="$HOST"
if [ -n "$PUERTO" ]; then
  case "$PUERTO" in
    (*[!0-9]*|'') muere "el puerto declarado para «${HOST}» no es un número: «${PUERTO}»" ;;
  esac
  [ "$PUERTO" -ge 1 ] && [ "$PUERTO" -le 65535 ] || muere "el puerto declarado para «${HOST}» está fuera de rango (1-65535): «${PUERTO}»"
  SERVIDOR="${HOST},${PUERTO}"
fi

SALIDA="$(HOME=/var/empty SQLCMDPASSWORD="$CLAVE" "$CLIENTE" -x -S "$SERVIDOR" ${ARGS_BASE[@]+"${ARGS_BASE[@]}"} -U "$USUARIO" -Q "$SENTENCIA" -W -s '|' -b 2>&1)"
RC=$?
CLAVE=""
FILAS="$(printf '%s\n' "$SALIDA" | wc -l | tr -d ' ')"
printf '%s\n' "$SALIDA" | head -n "$MAX_FILAS"
[ "$FILAS" -gt "$MAX_FILAS" ] && printf '… (cortado en %s de %s líneas; pedí más con --max-rows N)\n' "$MAX_FILAS" "$FILAS"
printf 'rc=%s\n' "$RC"
# El rechazo del firewall nombra el paso siguiente: sin esto, el asistente veía el error de Azure («use the Azure
# Management Portal») y mandaba a la persona al portal, con producción caída.
# Se reconoce por el texto del rechazo, no por el número suelto: un «40615» en los datos o en otro error no es el
# firewall. Y sólo en un Azure SQL, que es lo único que `--open-firewall` atiende.
if [ "$RC" != 0 ] && [[ "$HOST" == *.database.windows.net ]] \
   && printf '%s' "$SALIDA" | grep -iE "Client with IP address '[^']*' is not allowed to access the server" >/dev/null; then
  # Abrirlo lo corre la persona en su terminal: el modo automático del asistente lo frena (fila 248). Va a nombre de
  # esta sesión, para que la regla viva lo que vive ella; sin una sesión que se pueda leer, sin `--session`
  SES_FW="${CLAUDE_CODE_SESSION_ID:-}"; if [[ "$SES_FW" =~ $SESION_VALIDA ]]; then SES_FW=" --session $SES_FW"; else SES_FW=""; fi
  printf '\n🔥 La conexión la rechazó el firewall de Azure: la IP de esta máquina no está habilitada en «%s».\n' "$HOST"
  printf '   Paso siguiente: abrirlo lo corre la persona en su terminal, no el asistente. Pedile que copie y corra:\n'
  printf '     /opt/tycon/bin/tycon-prod-sql --open-firewall %s%s\n' "$HOST" "$SES_FW"
  printf '   (aprueba el cuadro; la regla se cierra sola cuando termina esta sesión, o a las 8 h aunque siga)\n'
  printf '   y después volvé a correr esta misma sentencia. No hace falta el portal.\n'
fi
anotar "\"host\":\"$HOST\",\"accion\":\"consulta\",\"sha256\":\"$(printf '%s' "$SENTENCIA" | shasum -a 256 | cut -d' ' -f1)\"$APROBACION,\"exit\":$RC,\"filas\":$FILAS"
exit "$RC"
