#!/usr/bin/env bash
# .githooks/pre-commit-checks — los controles que corre cada commit del arnés.
#
# Dos partes, cada una en su propio proceso: una salida temprana de una (un «no me toca») no saltea a la otra. El commit
# se crea sólo si pasan las dos.
#   · checks_harness — lo que mira el árbol entero: el frontmatter de las stories, el portón de cierre, los frenos de
#     nombres y de historia interna, el mapa de renombres, el quoting de bash 3.2, la versión bajada, las reglas de la CI,
#     el presupuesto de los bloques del CLAUDE.md, la versión pública del mapa del arnés y la paridad Claude↔Codex.
#   · checks_skills — lo que mira las skills y los revisores: los frenos de nombres con la fuente de las skills, las skills
#     de terceros sin declarar, la paridad de un revisor tocado y su chequeo de vida.
# La llama `.githooks/pre-commit`. Los cuerpos de las dos partes van sin sangría: las pruebas que cortan el tramo de un
# control lo buscan hasta su `fi` de primer nivel. Un control que no puede mirar frena: no poder mirar no es verde. Un control que se
# corre en cada commit tiene que ser barato: cada uno mira sólo si el commit trae lo suyo.
set -uo pipefail

# El arnés de las dos partes es la raíz de este repo, salvo que quien llama diga otro (TYCON_GUIDES_DIR y
# TYCON_SKILLS_DIR): los guiones que corren los controles son los de este árbol, no los de otra instalación.
# (si quien llama nombró el arnés, la parte de las skills avisa que le falta un guion aunque ahí no haya arnés)
_checks_named_harness="${TYCON_GUIDES_DIR:+1}"
if _checks_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  export TYCON_GUIDES_DIR="${TYCON_GUIDES_DIR:-$_checks_root}" TYCON_SKILLS_DIR="${TYCON_SKILLS_DIR:-$_checks_root}"
fi

# El arnés que trae los guiones de la parte de las skills: la variable; si no, ~/.claude/tycon-harness y después el nombre
# de antes, ~/.claude/tycon-claude-guides, bajo HOME y —en Windows, con HOME en otra carpeta— bajo USERPROFILE. Es la misma
# función que la del hook global (scripts/hooks/git-pre-commit-global.sh), letra por letra: los dos nombres van escritos
# (scripts/tests/fixtures/harness-place-names.json lo declara). Sin `-L` ni `readlink`: no andan igual en el bash de Git
# para Windows; alcanza con que la carpeta exista.
harness_dir() {
  if [ -n "${TYCON_GUIDES_DIR:-}" ]; then printf '%s' "$TYCON_GUIDES_DIR"; return 0; fi
  for _hd_base in "${HOME:-}" "${USERPROFILE:-}"; do
    [ -n "$_hd_base" ] || continue
    if command -v cygpath >/dev/null 2>&1; then _hd_base="$(cygpath -u "$_hd_base" 2>/dev/null || printf '%s' "$_hd_base")"; fi
    for _hd_name in tycon-harness tycon-claude-guides; do
      if [ -d "$_hd_base/.claude/$_hd_name/scripts" ]; then printf '%s' "$_hd_base/.claude/$_hd_name"; return 0; fi
    done
  done
  printf '%s' "${HOME:-}/.claude/tycon-harness"
}

checks_harness() (
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# Lo que trae el commit, leído una vez y mirando el código de salida de git: `git diff | grep -q` con pipefail sale 141
# cuando grep se va antes de que git termine, y el control se saltea sin decirlo. Se busca sobre la variable (`<<<`).
# Dos listas: `ACMR` es lo que hay que LEER (la ruta vieja de un movido no está en el árbol); `--no-renames` es lo que TOCA una
# ruta vigilada, también al irse (un movido son dos líneas, la vieja y la nueva). `core.quotePath=false`: una ruta con
# acentos o `ñ` sale tal cual y coincide con los patrones.
if ! STAGED_ACMR="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)"; then
  echo "⛔ COMMIT RECHAZADO — no pude leer la lista de lo que trae el commit (git diff --cached falló, arriba dice por qué): sin la lista ningún control sabe si le toca, y no poder mirar no es verde." >&2
  exit 1
fi
if ! STAGED_ALL="$(git -c core.quotePath=false diff --cached --name-only --no-renames)"; then
  echo "⛔ COMMIT RECHAZADO — no pude leer la lista de lo que trae el commit (git diff --cached --no-renames falló, arriba dice por qué): no poder mirar no es verde." >&2
  exit 1
fi

# ── El lint de frontmatter de stories ──
# Una story con el frontmatter roto no da error: desaparece de las herramientas que la leen. Va antes del filtro de la
# paridad (más abajo), que no mira specs/. Se le pasan todos los `.md` del commit: quién es una story lo decide el lint.
# Se busca por `$REPO_ROOT`: el repo del hook es el arnés. Sin el lint avisa y sigue.
# Casos: scripts/tests/pre-commit-stories.test.sh
FM_LINT="$REPO_ROOT/scripts/lib/lint-story-frontmatter.js"
CHANGED_MD="$(grep -E '\.md$' <<<"$STAGED_ACMR" || true)"
if [ -n "$CHANGED_MD" ]; then
  if [ ! -f "$FM_LINT" ]; then
    echo "⚠️  tycon: no encontré $FM_LINT — se saltea el lint de frontmatter de stories." >&2
  else
    echo "▸ pre-commit: lint de frontmatter de stories…"
    # shellcheck disable=SC2086
    if ! node "$FM_LINT" $CHANGED_MD; then
      echo "" >&2
      echo "⛔ COMMIT RECHAZADO — hay stories que el harness no puede leer (motivo arriba)." >&2
      echo "   Una story con el frontmatter roto no da error: desaparece en silencio del validator," >&2
      echo "   del backfill de back-links, de los scripts de status y del gate de DoD." >&2
      echo "   Si estás seguro de lo que hacés: git commit --no-verify (queda sin control)." >&2
      exit 1
    fi
  fi
fi

# ── El portón de cierre de stories ──
# El mismo control que corre en el pedido (guides/ci-gate.md), en la máquina: una story que pasa a review/done trae su
# evidencia de cierre y su registro de revisores en este repo. `--staged` mira sólo lo que el commit agrega.
# Casos: scripts/tests/pre-commit-stories.test.sh C-06/C-07.
GATE="$REPO_ROOT/scripts/ci/tycon-ci-gate.js"
# el portón usa el detector del lint: sin el lint tampoco corre, y eso ya se avisó arriba
if [ -n "$CHANGED_MD" ] && [ -f "$FM_LINT" ]; then
  if [ ! -f "$GATE" ]; then
    echo "⚠️  tycon: no encontré $GATE — se saltea el portón del arnés (el del pull request igual lo mira)." >&2
  elif ! node "$GATE" --repo "$REPO_ROOT" --staged; then
    echo "⛔ COMMIT RECHAZADO — el portón del arnés (el motivo está arriba)." >&2
    exit 1
  fi
fi

# ── El freno de nombres reales nuevos en lo que se publica ──
# Un commit que mete un nombre de cliente, persona, servidor o máquina en un archivo que sale en la copia pública no se
# crea. Mira lo que el commit AGREGA (neto), con la clasificación del exportador y el índice que git le pasa al hook:
# retocar, mover o renombrar lo que ya estaba no frena. Sin el guion y sin el perfil del equipo (team-profile.json, o
# perfil-equipo.json, el nombre de antes) no dice nada; con el perfil, que falte el guion es «no pude mirar». En un clon
# de la copia publicada lo mira con la lista privada de la máquina (`paths.maintainers`). Apagado, con aviso en cada
# commit: TYCON_NEW_NAMES=0.
# Casos: scripts/tests/new-names.test.js y C-13..C-15 de githook-livefire.test.sh
NEW_NAMES="$REPO_ROOT/scripts/publishing/new-names.js"
if [ -f "$NEW_NAMES" ]; then
  if ! node "$NEW_NAMES" --repo "$REPO_ROOT"; then
    echo "⛔ COMMIT RECHAZADO — nombres reales en lo que se publica, o no se pudo mirar (arriba dice dónde y cómo salir)." >&2
    exit 1
  fi
elif [ -f "$REPO_ROOT/team-profile.json" ] || [ -f "$REPO_ROOT/perfil-equipo.json" ]; then
  echo "⛔ COMMIT RECHAZADO — nombres nuevos: no pude mirar (falta ${NEW_NAMES}). El arnés del equipo tiene el freno; sin él no se mira, y no poder mirar no es verde." >&2
  exit 1
fi

# ── El freno de nombres nuevos en castellano en lo que ejecuta la máquina ──
# Archivos, opciones, subcomandos, variables y claves de lo que se publica van en inglés: un nombre castellano que no
# existía no entra; uno que ya existe pasa mientras no se renombre. Apagado, con aviso en cada commit:
# TYCON_SPANISH_NAMES=0. Guía: guides/nombres-en-ingles.md.
# Casos: scripts/tests/spanish-names.test.js y C-16..C-24 de githook-livefire.test.sh
SPANISH_NAMES="$REPO_ROOT/scripts/publishing/spanish-names.js"
if [ -f "$SPANISH_NAMES" ]; then
  if ! node "$SPANISH_NAMES" --repo "$REPO_ROOT"; then
    echo "⛔ COMMIT RECHAZADO — nombres nuevos en castellano en lo que se publica, o no se pudo mirar (arriba dice dónde y cómo salir)." >&2
    exit 1
  fi
elif [ -f "$REPO_ROOT/team-profile.json" ] || [ -f "$REPO_ROOT/perfil-equipo.json" ]; then
  echo "⛔ COMMIT RECHAZADO — nombres en castellano: no pude mirar (falta ${SPANISH_NAMES}). El arnés del equipo tiene el freno; sin él no se mira." >&2
  exit 1
fi

# ── La historia interna en la prosa que se publica ──
# Una referencia interna (el número de una story, el código de un trabajo, un caso del registro interno, una rama, un
# commit o una corrida) no lleva a nada desde afuera. Mira lo que el commit AGREGA a la prosa que se publica (el código y las pruebas no son
# suyos). Frena según scripts/publishing/internal-history.json → mode. Bajado a aviso: TYCON_INTERNAL_HISTORY=warn;
# apagado, con aviso en cada commit: TYCON_INTERNAL_HISTORY=0.
# Casos: scripts/tests/internal-history-guard.test.js y scripts/controls-bench/cases/hooks/52-internal-history.json
INTERNAL_HISTORY="$REPO_ROOT/scripts/publishing/internal-history.js"
if [ -f "$INTERNAL_HISTORY" ]; then
  if ! node "$INTERNAL_HISTORY" --repo "$REPO_ROOT" >/dev/null; then
    echo "⛔ COMMIT RECHAZADO — historia interna en la prosa que se publica, o no se pudo mirar (arriba dice dónde y cómo salir)." >&2
    exit 1
  fi
elif [ -f "$REPO_ROOT/team-profile.json" ] || [ -f "$REPO_ROOT/perfil-equipo.json" ]; then
  echo "⛔ COMMIT RECHAZADO — historia interna: no pude mirar (falta ${INTERNAL_HISTORY}). El arnés del equipo tiene el control; sin él no se mira." >&2
  # el rechazo también queda en el registro de frenos (el guion que lo anotaría es justo el que falta); nunca cambia la salida
  if [ -f "$REPO_ROOT/scripts/lib/guard-record.js" ]; then
    node "$REPO_ROOT/scripts/lib/guard-record.js" --guard internal-history --rule could-not-look --verdict bloqueo >/dev/null 2>&1 || true
  fi
  exit 1
fi

# ── El mapa de renombres ──
# Si el commit lo toca, se valida el del índice (no el del disco): repetidos, un nombre nuevo en castellano, uno que
# choca, un valor sin su script o un archivo que llaman de afuera sin su reemplazo frenan.
if git -C "$REPO_ROOT" diff --cached --name-only -- scripts/lib/renames.json | grep -q . && [ -f "$SPANISH_NAMES" ]; then
  # un borrado del mapa no tiene nada que validar; cualquier otra falla de git al leerlo es «no pude mirar», y frena
  if ! git -C "$REPO_ROOT" diff --cached --name-status -- scripts/lib/renames.json | grep -q '^D'; then
    _MAPA_IDX="$(mktemp)" || { echo "⛔ COMMIT RECHAZADO — no pude validar el mapa de renombres (sin carpeta temporal)." >&2; exit 1; }
    if ! git -C "$REPO_ROOT" show :scripts/lib/renames.json > "$_MAPA_IDX"; then
      rm -f "$_MAPA_IDX"
      echo "⛔ COMMIT RECHAZADO — no pude leer el mapa de renombres del índice (git show falló): no se valida a ciegas." >&2
      exit 1
    fi
    if ! node "$SPANISH_NAMES" --check-map --map "$_MAPA_IDX" --map-name scripts/lib/renames.json --repo "$REPO_ROOT"; then
      rm -f "$_MAPA_IDX"
      echo "⛔ COMMIT RECHAZADO — el mapa de renombres no pasa (arriba dice qué entrada y por qué)." >&2
      exit 1
    fi
    rm -f "$_MAPA_IDX"
  fi
fi

# ── `$VAR` pegado a un carácter no ASCII en los .sh ──
# En el bash 3.2 de macOS eso parte la variable, y en Linux con bash 5 no se reproduce. Mira lo stageado; un guion que
# no se puede leer del índice frena.
# Casos: scripts/tests/bash32-quoting.test.sh
if grep -qE '\.sh$' <<<"$STAGED_ACMR"; then
  B32="$REPO_ROOT/scripts/ci/check-bash32-quoting.sh"
  if [ ! -f "$B32" ]; then
    echo "⛔ COMMIT RECHAZADO — no encontré $B32, así que NO pude mirar el quoting de bash 3.2 en los .sh stageados. No medido no es verde."
    exit 1
  fi
  echo "▸ pre-commit: \$VAR pegado a caracteres no ASCII en los .sh stageados (bash 3.2)…"
  bash "$B32" --staged; B32_RC=$?
  if [ "$B32_RC" != 0 ]; then
    echo "⛔ COMMIT RECHAZADO — hay \$VAR pegado a un carácter no ASCII (arriba dice dónde): en el bash 3.2 de macOS eso parte la variable. Usá \${VAR}."
    exit 1
  fi
fi

# ── Lo que rompería la verificación de una versión bajada ──
# Un export-ignore o export-subst en un .gitattributes publicado, un enlace simbólico o un submódulo en una ruta
# publicada. Mira lo que el commit agrega o cambia (`--staged`). Sólo donde hay algo publicado que cuidar: un repo sin
# lista blanca (scripts/publishing/allowlist.json) no publica nada y el control se saltea diciéndolo. Con la lista y
# sin el guion, o con el guion que no puede mirar (rc 2), frena.
# Casos: scripts/tests/check-publishable-tree.test.js (T20) · scripts/tests/githook-renames.test.sh
PUBTREE="$REPO_ROOT/scripts/ci/check-publishable-tree.js"
if [ ! -f "$REPO_ROOT/scripts/publishing/allowlist.json" ]; then
  echo "▸ pre-commit: sin lista blanca de publicación en este repo: no hay versión bajada que cuidar; se saltea" >&2
elif [ ! -f "$PUBTREE" ]; then
  echo "⛔ COMMIT RECHAZADO — no encontré $PUBTREE, así que NO pude mirar si este commit rompe la verificación de lo publicado. No medido no es verde. Si el checkout está incompleto: git checkout scripts/ci/check-publishable-tree.js" >&2
  exit 1
else
  echo "▸ pre-commit: lo que rompería la verificación de la versión bajada (enlaces, submódulos, export-ignore)…"
  node "$PUBTREE" --repo "$REPO_ROOT" --staged; PUBTREE_RC=$?
  if [ "$PUBTREE_RC" = 1 ]; then
    echo "⛔ COMMIT RECHAZADO — este commit mete algo que rompería la instalación sin git (arriba dice qué y dónde)." >&2
    exit 1
  elif [ "$PUBTREE_RC" != 0 ]; then
    echo "⛔ COMMIT RECHAZADO — no pude mirar si este commit rompe la verificación de lo publicado: no medido no es verde." >&2
    exit 1
  fi
fi

# ── Tres reglas de la CI pública, sobre lo que trae el commit ──
# `| grep -q` con pipefail en un .sh, una prueba que depende de un sha o de una hora que cambian, y el conteo del
# catálogo de reglas cuando el commit toca agents/ o el catálogo; con la misma lógica que sus pruebas (los módulos de
# scripts/lib/). Sin nada de eso sale en milisegundos. Sin el guion: en el arnés (trae la lista blanca de publicación)
# frena; en un repo de juguete de las suites del hook, lo dice y sigue.
# Casos: scripts/tests/check-staged-ci-rules.test.js
CI_RULES="$REPO_ROOT/scripts/ci/check-staged-ci-rules.js"
CI_RULES_RC=0
if [ ! -f "$CI_RULES" ]; then
  if [ -f "$REPO_ROOT/scripts/publishing/allowlist.json" ]; then
    echo "⛔ COMMIT RECHAZADO — no encontré $CI_RULES, así que NO pude mirar las reglas que frena la CI pública. No medido no es verde. Si el checkout está incompleto: git checkout scripts/ci/check-staged-ci-rules.js" >&2
    exit 1
  fi
  echo "▸ pre-commit: sin el guion de las reglas de la CI ni lista blanca de publicación: no es el arnés; se saltea" >&2
else
  node "$CI_RULES" --repo "$REPO_ROOT"; CI_RULES_RC=$?
fi
if [ "$CI_RULES_RC" = 1 ]; then
  echo "⛔ COMMIT RECHAZADO — arriba dice archivo, línea y cómo arreglarlo." >&2
  exit 1
elif [ "$CI_RULES_RC" != 0 ]; then
  echo "⛔ COMMIT RECHAZADO — no pude mirar las reglas que frena la CI pública (arriba dice por qué): no medido no es verde." >&2
  exit 1
fi

# ── El presupuesto de lo que se carga en cada sesión ──
# Cada bloque de claude-md-blocks/ y el README se cargan enteros en cada sesión y en cada subagente:
# claude-md-blocks/budget.json declara el techo de cada uno y el guion lo verifica sobre el índice (pasarse frena; lo
# que el commit agrega con forma de historia avisa). Dispara también con la guía del detalle, para mirar el par
# índice↔guía. Sin el guion frena.
# Casos: scripts/tests/claude-md-blocks.test.sh · C-11, C-11b y C-11c de githook-livefire.test.sh
if grep -qE '^(claude-md-blocks/|README\.md$|guides/piezas-del-arnes\.md$)' <<<"$STAGED_ALL"; then
  CMB="$REPO_ROOT/scripts/ci/check-claude-md-blocks.js"
  if [ ! -f "$CMB" ]; then
    echo "⛔ COMMIT RECHAZADO — no encontré $CMB, así que NO pude medir los bloques del CLAUDE.md ni el techo del README. No medido no es verde. Si el checkout está incompleto: git checkout scripts/ci/check-claude-md-blocks.js" >&2
    exit 1
  else
    echo "▸ pre-commit: presupuesto de los bloques del CLAUDE.md y de lo que se importa en cada sesión…"
    node "$CMB" --repo "$REPO_ROOT" --staged; CMB_RC=$?
    if [ "$CMB_RC" = 1 ]; then
      echo "⛔ COMMIT RECHAZADO — un bloque del CLAUDE.md, o un archivo que se importa entero en cada sesión (el README), se pasa de su techo (arriba dice cuál y por qué). El detalle va a guides/piezas-del-arnes.md; subir el techo se decide en claude-md-blocks/budget.json, con motivo." >&2
      exit 1
    elif [ "$CMB_RC" != 0 ]; then
      echo "⛔ COMMIT RECHAZADO — no pude medir los bloques del CLAUDE.md ni los archivos importados (presupuesto o guía de detalle ilegibles): no medido no es verde." >&2
      exit 1
    fi
  fi
fi

# ── La versión pública del mapa del arnés ──
# onboarding/mini-class/mapa-del-arnes.html se deriva de artifacts/mapa-arnes.html. Si el commit toca la privada o el
# generador, la pública se regenera desde el índice y entra sola en el commit; si toca sólo la pública y no coincide con
# lo que se genera, frena. Antes de generar, el tipo de cada ficha tiene que ser el que le da su ruta (census.js
# --check). En un repo que no trae el mapa interno —ni en el índice ni en HEAD— no hay versión pública que derivar y se
# dice; si HEAD lo trae y el índice no (movido o borrado), corre y frena como siempre.
# Casos: scripts/tests/harness-map-public.test.sh · harness-map-census.test.sh (C-08 a C-12) ·
# githook-livefire.test.sh (C-26/C-27)
MAPA_TOCADO="$(grep -E '^(artifacts/mapa-arnes\.html$|scripts/tools/harness-map/|onboarding/mini-class/mapa-del-arnes\.html$)' <<<"$STAGED_ALL" || true)"
if [ -n "$MAPA_TOCADO" ] && ! git cat-file -e :artifacts/mapa-arnes.html 2>/dev/null \
   && ! git cat-file -e HEAD:artifacts/mapa-arnes.html 2>/dev/null; then
  echo "▸ pre-commit: este repo no trae el mapa interno del arnés (artifacts/mapa-arnes.html): no hay versión pública que regenerar."
  MAPA_TOCADO=""
fi
if [ -n "$MAPA_TOCADO" ]; then
  MAPA_GEN="$REPO_ROOT/scripts/tools/harness-map/public-version.js"
  if [ ! -f "$MAPA_GEN" ]; then
    echo "⚠️  tycon: no encontré $MAPA_GEN — no se regeneró la versión pública del mapa del arnés." >&2
  else
    echo "▸ pre-commit: versión pública del mapa del arnés…"
    MAPA_TMP="$(mktemp -d)"
    if ! git show :artifacts/mapa-arnes.html > "$MAPA_TMP/privada.html" 2>/dev/null \
       || ! git show :scripts/tools/harness-map/publica.json > "$MAPA_TMP/publica.json" 2>/dev/null; then
      rm -rf "$MAPA_TMP"
      echo "⛔ COMMIT RECHAZADO — no pude leer del índice la privada o publica.json del mapa del arnés." >&2
      exit 1
    fi
    # la privada del índice, en la forma de un arnés (<raíz>/artifacts/mapa-arnes.html) para `--tcg`
    mkdir -p "$MAPA_TMP/tcg/artifacts" && cp "$MAPA_TMP/privada.html" "$MAPA_TMP/tcg/artifacts/mapa-arnes.html"
    if ! node "$REPO_ROOT/scripts/tools/harness-map/census.js" --check --tcg "$MAPA_TMP/tcg"; then
      rm -rf "$MAPA_TMP"
      echo "⛔ COMMIT RECHAZADO — el tipo de alguna pieza del mapa no es el que le da su ruta (el detalle está arriba)." >&2
      exit 1
    fi
    if ! node "$MAPA_GEN" --input "$MAPA_TMP/privada.html" --config "$MAPA_TMP/publica.json" --output "$MAPA_TMP/publica.html"; then
      rm -rf "$MAPA_TMP"
      echo "⛔ COMMIT RECHAZADO — la versión pública del mapa del arnés no se pudo generar (el motivo está arriba)." >&2
      exit 1
    fi
    MAPA_PUB="onboarding/mini-class/mapa-del-arnes.html"
    if ! git show ":$MAPA_PUB" 2>/dev/null | cmp -s - "$MAPA_TMP/publica.html"; then
      if echo "$MAPA_TOCADO" | grep -qvE "^$MAPA_PUB\$"; then
        cp "$MAPA_TMP/publica.html" "$REPO_ROOT/$MAPA_PUB" && git add "$MAPA_PUB"
        echo "▸ pre-commit: la versión pública del mapa se regeneró y entra en este commit."
      else
        rm -rf "$MAPA_TMP"
        echo "⛔ COMMIT RECHAZADO — $MAPA_PUB no se edita a mano: se cambia la privada (artifacts/mapa-arnes.html) o scripts/tools/harness-map/publica.json." >&2
        exit 1
      fi
    fi
    rm -rf "$MAPA_TMP"
  fi
fi

# ── La paridad Claude↔Codex (build/check.js) ──
# Los .toml de los revisores al día con su markdown canónico, todo hook del banco registrado del lado Codex (o su
# divergencia declarada), y una pieza nueva entra con sus casos en el banco. Corre sólo si el commit toca lo que puede
# romperla, incluida esta lista de disparo (este archivo está en `.githooks/`).
RELEVANTES='^(adapters/|build/|scripts/controls-bench/|scripts/hooks/|scripts/install-tycon-hooks\.sh|\.githooks/|agents/)'
if ! grep -qE "$RELEVANTES" <<<"$STAGED_ALL"; then
  exit 0
fi

# en un repo que no es el arnés (sin build/check.js ni lista blanca de publicación: los de juguete de las suites del hook)
# no hay paridad que mirar; en el arnés, que falte el guion es «no pude mirar» y frena
if [ ! -f "$REPO_ROOT/build/check.js" ]; then
  if [ -f "$REPO_ROOT/scripts/publishing/allowlist.json" ]; then
    echo "⛔ COMMIT RECHAZADO — no encontré $REPO_ROOT/build/check.js, así que NO pude mirar la paridad Claude↔Codex. No medido no es verde." >&2
    exit 1
  fi
  echo "▸ pre-commit: sin build/check.js ni lista blanca de publicación: no es el arnés; la paridad se saltea" >&2
  exit 0
fi
echo "▸ pre-commit: verificando la paridad Claude↔Codex (build/check.js)…"
if ! node "$REPO_ROOT/build/check.js" > /tmp/tycon-check-$$.log 2>&1; then
  echo "" >&2
  echo "⛔ COMMIT RECHAZADO — la paridad quedó desalineada:" >&2
  grep -E '^(❌|   ·|⚠)' /tmp/tycon-check-$$.log >&2 || tail -20 /tmp/tycon-check-$$.log >&2
  echo "" >&2
  echo "   Reporte completo: /tmp/tycon-check-$$.log" >&2
  echo "   Si estás seguro de lo que hacés: git commit --no-verify (queda sin control, a tu criterio)." >&2
  exit 1
fi

rm -f /tmp/tycon-check-$$.log
echo "▸ pre-commit: paridad OK"
exit 0
)

checks_skills() (
cd "$(git rev-parse --show-toplevel)" || exit 0
TCG="$(harness_dir)"
# los guiones de publicación del arnés que corre esta parte
harness_publishing() {
  if [ -f "${TCG}/scripts/publishing/$1" ]; then printf '%s' "${TCG}/scripts/publishing/$1"
  elif [ -f "${TCG}/scripts/publishing/$1" ]; then printf '%s' "${TCG}/scripts/publishing/$1"
  else printf '%s' "${TCG}/scripts/publishing/$1"; fi
}
# Un guion que falta se avisa cuando hay un arnés donde buscarlo (su carpeta de publicación): ahí falta una pieza. Sin
# arnés (un repo de juguete de las suites del hook) no hay qué mirar, y la parte del arnés ya dijo lo suyo.
harness_here() { [ -n "${_checks_named_harness:-}" ] || [ -d "${TCG}/scripts/publishing" ] || [ -d "${TCG}/scripts/publicacion" ]; }

# ── El freno de nombres reales nuevos, con la fuente de las skills ──
# Lo que sale de las skills y los revisores en la copia pública no son sólo los revisores (skills, pasos, comandos). Mira
# lo que el commit AGREGA (neto). Con un arnés que no trae el guion, avisa fuerte y deja pasar, como la paridad de
# abajo; con el guion y una lista que no se lee, frena.
NEW_NAMES="$(harness_publishing new-names.js)"
if [ ! -f "$NEW_NAMES" ] || ! command -v node >/dev/null 2>&1; then
  harness_here || NEW_NAMES=""
  [ -z "$NEW_NAMES" ] || echo "⚠⚠ pre-commit AgentSkills: no encontré el freno de nombres nuevos (${NEW_NAMES})." >&2
  [ -z "$NEW_NAMES" ] || echo "   NO se miró si este commit mete nombres reales en lo que se publica: actualizá el arnés (git -C ${TCG} pull) o seteá TYCON_GUIDES_DIR." >&2
elif ! node "$NEW_NAMES" --repo "$(pwd)" --source agent-skills; then
  echo "⛔ COMMIT RECHAZADO — nombres reales en lo que se publica, o no se pudo mirar (arriba dice dónde y cómo salir)." >&2
  exit 1
fi

# ── El freno de nombres nuevos en castellano, con la fuente de las skills ──
# Con un arnés que no trae el guion, avisa fuerte y deja pasar, como el de arriba.
SPANISH_NAMES="$(harness_publishing spanish-names.js)"
if [ ! -f "$SPANISH_NAMES" ] || ! command -v node >/dev/null 2>&1; then
  harness_here || SPANISH_NAMES=""
  [ -z "$SPANISH_NAMES" ] || echo "⚠⚠ pre-commit AgentSkills: no encontré el freno de nombres en castellano (${SPANISH_NAMES})." >&2
  [ -z "$SPANISH_NAMES" ] || echo "   NO se miró si este commit mete nombres nuevos en castellano en lo que se publica: actualizá el arnés (git -C ${TCG} pull) o seteá TYCON_GUIDES_DIR." >&2
elif ! node "$SPANISH_NAMES" --repo "$(pwd)" --source agent-skills; then
  echo "⛔ COMMIT RECHAZADO — nombres nuevos en castellano en lo que se publica, o no se pudo mirar (arriba dice dónde y cómo salir)." >&2
  exit 1
fi

# ── Nada ajeno sin declarar ──
# Una skill de internet copiada al árbol sin declararla en el manifiesto de terceros (con su origen, commit y árbol)
# frena el día que se copia. Corre sólo si el commit toca skills/, agents/, .agents/, .claude/ o stagea un enlace
# simbólico; sin red y en milisegundos (el contenido lo compara la suite). Con un arnés que no trae el control, avisa y
# deja pasar. Un git que falla no se lee como «no toca nada»: el control corre igual.
TERCEROS_TOCA="$(git diff --cached --name-only -- skills agents .agents .claude)" || TERCEROS_TOCA="?"
TERCEROS_RAW="$(git diff --cached --raw --no-renames)" || TERCEROS_RAW=":? 120000 (git diff falló)"
TERCEROS_ENLACE="$(printf '%s\n' "$TERCEROS_RAW" | awk '$2 == "120000" { print; exit }')"
if [ -n "$TERCEROS_TOCA" ] || [ -n "$TERCEROS_ENLACE" ]; then
  COVERAGE="$(harness_publishing third-party-coverage.js)"
  if [ ! -f "$COVERAGE" ] || ! command -v node >/dev/null 2>&1; then
    harness_here || COVERAGE=""
    [ -z "$COVERAGE" ] || echo "⚠⚠ pre-commit AgentSkills: no encontré el control de skills de terceros (${COVERAGE})." >&2
    [ -z "$COVERAGE" ] || echo "   NO se miró si este commit mete una skill ajena sin declarar: actualizá el arnés (git -C ${TCG} pull) o seteá TYCON_GUIDES_DIR." >&2
  elif ! node "$COVERAGE" --repo "$(pwd)" --skip-content >&2; then
    echo "⛔ COMMIT RECHAZADO — algo en agent-skills no está declarado en el manifiesto de terceros, o no se pudo mirar (arriba dice qué)." >&2
    echo "   Una skill ajena se declara en $(dirname "$COVERAGE")/third-party-skills.json con su origen, commit y árbol; una propia, en «own»." >&2
    exit 1
  fi
fi

# ── La paridad Codex de un revisor tocado ──
# Mira los revisores de la raíz y los de la carpeta de agentes de un paquete: `packs/<p>/agents/` es la única carpeta de
# agentes que la capa del equipo acepta (team.js); un paquete que declare otra en su manifiesto no pasa por acá. Sólo
# actúa si el commit stagea uno. Limitación: check.js valida el árbol de trabajo, no el índice (con `git add -p` y
# seguir editando puede pasar una versión no mirada).
cambiados="$(git diff --cached --name-only -- 'agents/*.md' 'packs/*/agents/*.md')" || {
  echo "⚠ pre-commit AgentSkills: git diff falló — no pude determinar si el commit toca advisors" >&2
  exit 0
}
[ -z "$cambiados" ] && exit 0

CHECK="$TCG/build/check.js"
if [ ! -f "$CHECK" ] || ! command -v node >/dev/null 2>&1; then
  # sin el arnés no se puede verificar: se avisa fuerte, no se bloquea
  echo "⚠⚠ pre-commit AgentSkills: no pude correr el check de paridad Codex ($CHECK)." >&2
  echo "   El commit toca advisors y su traducción puede quedar VIEJA." >&2
  echo "   Cloná/ubicá el arnés o seteá TYCON_GUIDES_DIR." >&2
  exit 0
fi

# silencioso en verde: un control ruidoso en verde se termina salteando
LOG="/tmp/tycon-askills-check-$$.log"
if node "$CHECK" >"$LOG" 2>&1; then
  echo "✅ paridad Codex de advisors OK"
  rm -f "$LOG"

  # El chequeo de vida del revisor tocado: la paridad dice que la traducción está al día, no que el revisor siga
  # funcionando, y esta edición es el momento en que se puede romper. Cuesta ~40 s y 2 consultas. Un rojo de una
  # corrida es una sospecha: el control confirma con 3 y frena sólo si el revisor falló las tres; nunca frena por
  # plomería (sin red, sin sesión, el corral que se escapa: avisa y deja pasar). Apagado: TYCON_NO_LIVENESS_PRECOMMIT=1
  VIDA="$TCG/scripts/hooks/advisor-liveness-on-change.js"
  [ -f "$VIDA" ] || VIDA="$TCG/scripts/hooks/advisor-liveness-on-change.js"
  if [ -f "$VIDA" ]; then
    # shellcheck disable=SC2086
    node "$VIDA" $cambiados || exit 1
  fi
  exit 0
fi
grep -E "❌|⛔" "$LOG" >&2 || tail -20 "$LOG" >&2
echo "" >&2
echo "⛔ El commit toca advisors y el check de paridad Codex dio rojo. Para destrabar:" >&2
echo "   · toml desactualizado → node $TCG/build/generate.js --deploy y commitear adapters en el arnés" >&2
echo "   · bank-coverage → el advisor nuevo entra CON sus casos en el banco (regla B2)" >&2
echo "   · registro de hooks → es drift en el arnés, no de tu advisor: arreglalo allá (guides/controls-bench.md)" >&2
echo "   (log completo: $LOG)" >&2
exit 1
)

fallo=0
checks_harness || fallo=1
checks_skills || fallo=1
exit "$fallo"
