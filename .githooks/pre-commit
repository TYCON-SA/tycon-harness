#!/usr/bin/env bash
# .githooks/pre-commit — corre los controles de cada commit del arnés (.githooks/pre-commit-checks) con la raíz del repo
# como arnés: los guiones que esos controles llaman son los de este árbol, no los de otra instalación.
set -u
raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export TYCON_GUIDES_DIR="$raiz" TYCON_SKILLS_DIR="$raiz"
if [ -x "$raiz/.githooks/pre-commit-checks" ]; then exec "$raiz/.githooks/pre-commit-checks"; fi
exec bash "$raiz/.githooks/pre-commit-checks"
